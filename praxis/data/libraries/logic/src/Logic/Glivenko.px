                :@ (Intuitionistic.S {(a :=> Bottom) :=> Bottom} {Bottom} {a}
                      :@ (Intuitionistic.K {Bottom :=> a} {(a :=> Bottom) :=> Bottom}
                            :@ Intuitionistic.Explosion {a})))
          :@ double-negation-dne-part-2 {a})


bottom-out : Intuitionistic (((Bottom :=> Bottom) :=> Bottom) :=> Bottom)
bottom-out =
  Intuitionistic.S {(Bottom :=> Bottom) :=> Bottom} {Bottom :=> Bottom} {Bottom}
    :@ (Intuitionistic.S {(Bottom :=> Bottom) :=> Bottom} {((Bottom :=> Bottom) :=> Bottom) :=> (Bottom :=> Bottom) :=> Bottom} {(Bottom :=> Bottom) :=> Bottom}
          :@ Intuitionistic.K {(Bottom :=> Bottom) :=> Bottom} {((Bottom :=> Bottom) :=> Bottom) :=> (Bottom :=> Bottom) :=> Bottom}
          :@ Intuitionistic.K {(Bottom :=> Bottom) :=> Bottom} {(Bottom :=> Bottom) :=> Bottom})
    :@ (Intuitionistic.K {Bottom :=> Bottom} {(Bottom :=> Bottom) :=> Bottom}
          :@ (Intuitionistic.S {Bottom} {Bottom :=> Bottom} {Bottom}
                :@ Intuitionistic.K {Bottom} {Bottom :=> Bottom}
                :@ Intuitionistic.K {Bottom} {Bottom}))


peirce-part-1 : {a : Formula} -> {b : Formula} -> Classical (((a :=> b) :=> a) :=> (a :=> Bottom) :=> a)
peirce-part-1 {a} {b} =
  Classical.S {(a :=> b) :=> a} {(a :=> Bottom) :=> a :=> b} {(a :=> Bottom) :=> a}
    :@ (Classical.S {(a :=> b) :=> a} {(a :=> Bottom) :=> (a :=> b) :=> a} {((a :=> Bottom) :=> a :=> b) :=> (a :=> Bottom) :=> a}
          :@ (Classical.K {((a :=> Bottom) :=> (a :=> b) :=> a) :=> ((a :=> Bottom) :=> a :=> b) :=> (a :=> Bottom) :=> a} {(a :=> b) :=> a}
                :@ Classical.S {a :=> Bottom} {a :=> b} {a})
          :@ Classical.K {(a :=> b) :=> a} {a :=> Bottom})
    :@ (Classical.K {(a :=> Bottom) :=> a :=> b} {(a :=> b) :=> a}
          :@ (Classical.S {a} {Bottom} {b}
                :@ (Classical.K {Bottom :=> b} {a} :@ Classical.Explosion {b})))

peirce-part-2 : {a : Formula} -> {b : Formula} -> Classical (((a :=> b) :=> a) :=> (a :=> Bottom) :=> Bottom)
peirce-part-2 {a} {b} =
  Classical.S {(a :=> b) :=> a} {(a :=> Bottom) :=> a} {(a :=> Bottom) :=> Bottom}
    :@ (Classical.K {((a :=> Bottom) :=> a) :=> (a :=> Bottom) :=> Bottom} {(a :=> b) :=> a}
          :@ (Classical.S {a :=> Bottom} {a} {Bottom}
                :@ (Classical.S {a :=> Bottom} {(a :=> Bottom) :=> a :=> Bottom} {a :=> Bottom}
                      :@ Classical.K {a :=> Bottom} {(a :=> Bottom) :=> a :=> Bottom}
                      :@ Classical.K {a :=> Bottom} {a :=> Bottom})))
    :@ peirce-part-1 {a} {b}

peirce : {a : Formula} -> {b : Formula} -> Classical (((a :=> b) :=> a) :=> a)
peirce {a} {b} =
  Classical.S {(a :=> b) :=> a} {(a :=> Bottom) :=> Bottom} {a}
    :@ (Classical.K {((a :=> Bottom) :=> Bottom) :=> a} {(a :=> b) :=> a} :@ Classical.DNE {a})
    :@ peirce-part-2 {a} {b}
