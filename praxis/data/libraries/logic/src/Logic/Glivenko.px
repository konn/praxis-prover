          :@ (Intuitionistic.K {(((a :=> Bottom) :=> Bottom) :=> ((b :=> Bottom) :=> (a :=> b) :=> Bottom) :=> (b :=> Bottom) :=> Bottom) :=> (((a :=> Bottom) :=> Bottom) :=> (b :=> Bottom) :=> (a :=> b) :=> Bottom) :=> ((a :=> Bottom) :=> Bottom) :=> (b :=> Bottom) :=> Bottom} {((a :=> b) :=> Bottom) :=> Bottom}
