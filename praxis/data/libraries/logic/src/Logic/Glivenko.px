            (Intuitionistic.S {(Imp b Bottom)} {(Imp (Imp a b) (Imp a Bottom))} {(Imp (Imp a b) Bottom)})))
        (double-negation-mp-part-2 {a} {b})))
    (Intuitionistic.MP
      (Intuitionistic.K {(Imp (Imp b Bottom) (Imp (Imp a b) (Imp a Bottom)))} {(Imp (Imp a Bottom) Bottom)})
