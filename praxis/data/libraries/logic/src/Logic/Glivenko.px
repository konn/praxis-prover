double-negation-dne : {a : Formula} -> Intuitionistic (Imp (Imp (Imp (Imp (Imp a Bottom) Bottom) a) Bottom) Bottom)
double-negation-dne {a} =
  (Intuitionistic.MP
    (Intuitionistic.MP
      (Intuitionistic.S {(Imp (Imp (Imp (Imp a Bottom) Bottom) a) Bottom)} {(Imp (Imp (Imp a Bottom) Bottom) a)} {Bottom})
      (Intuitionistic.MP
        (Intuitionistic.MP
          (Intuitionistic.S {(Imp (Imp (Imp (Imp a Bottom) Bottom) a) Bottom)} {(Imp (Imp (Imp (Imp (Imp a Bottom) Bottom) a) Bottom) (Imp (Imp (Imp (Imp a Bottom) Bottom) a) Bottom))} {(Imp (Imp (Imp (Imp a Bottom) Bottom) a) Bottom)})
          (Intuitionistic.K {(Imp (Imp (Imp (Imp a Bottom) Bottom) a) Bottom)} {(Imp (Imp (Imp (Imp (Imp a Bottom) Bottom) a) Bottom) (Imp (Imp (Imp (Imp a Bottom) Bottom) a) Bottom))}))
        (Intuitionistic.K {(Imp (Imp (Imp (Imp a Bottom) Bottom) a) Bottom)} {(Imp (Imp (Imp (Imp a Bottom) Bottom) a) Bottom)})))
    (Intuitionistic.MP
      (Intuitionistic.MP
        (Intuitionistic.S {(Imp (Imp (Imp (Imp a Bottom) Bottom) a) Bottom)} {(Imp (Imp (Imp a Bottom) Bottom) Bottom)} {(Imp (Imp (Imp a Bottom) Bottom) a)})
