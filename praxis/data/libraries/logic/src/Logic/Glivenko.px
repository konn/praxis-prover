double-negation-intro : {a : Formula} -> Intuitionistic (Imp a (Imp (Imp a Bottom) Bottom))
double-negation-intro {a} =
  (Intuitionistic.MP
    (Intuitionistic.MP
      (Intuitionistic.S {a} {(Imp (Imp a Bottom) a)} {(Imp (Imp a Bottom) Bottom)})
      (Intuitionistic.MP
        (Intuitionistic.K {(Imp (Imp (Imp a Bottom) a) (Imp (Imp a Bottom) Bottom))} {a})
        (Intuitionistic.MP
          (Intuitionistic.S {(Imp a Bottom)} {a} {Bottom})
          (Intuitionistic.MP
            (Intuitionistic.MP
              (Intuitionistic.S {(Imp a Bottom)} {(Imp (Imp a Bottom) (Imp a Bottom))} {(Imp a Bottom)})
              (Intuitionistic.K {(Imp a Bottom)} {(Imp (Imp a Bottom) (Imp a Bottom))}))
            (Intuitionistic.K {(Imp a Bottom)} {(Imp a Bottom)})))))
    (Intuitionistic.K {a} {(Imp a Bottom)}))


double-negation-mp-part-1 : {a : Formula} -> {b : Formula} -> Intuitionistic (Imp (Imp (Imp (Imp a b) Bottom) Bottom) (Imp (Imp (Imp a Bottom) Bottom) (Imp (Imp (Imp b Bottom) (Imp (Imp a b) Bottom)) (Imp (Imp b Bottom) Bottom))))
double-negation-mp-part-1 {a} {b} =
  (Intuitionistic.MP
