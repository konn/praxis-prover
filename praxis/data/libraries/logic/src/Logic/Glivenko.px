      (Intuitionistic.K {(Imp a (Imp (Imp (Imp a Bottom) Bottom) a))} {(Imp (Imp (Imp (Imp a Bottom) Bottom) a) Bottom)})
      (Intuitionistic.K {a} {(Imp (Imp a Bottom) Bottom)})))

