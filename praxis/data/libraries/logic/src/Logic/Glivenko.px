bottom-out-step-3 = Intuitionistic.MP {(Imp Bottom (Imp (Imp Bottom Bottom) Bottom))} {(Imp (Imp Bottom (Imp Bottom Bottom)) (Imp Bottom Bottom))} (Intuitionistic.S {Bottom} {(Imp Bottom Bottom)} {Bottom}) (Intuitionistic.K {Bottom} {(Imp Bottom Bottom)})

bottom-out-step-4 : Intuitionistic (Imp Bottom Bottom)
bottom-out-step-4 = Intuitionistic.MP {(Imp Bottom (Imp Bottom Bottom))} {(Imp Bottom Bottom)} (bottom-out-step-3) (Intuitionistic.K {Bottom} {Bottom})

bottom-out-step-5 : Intuitionistic (Imp (Imp (Imp Bottom Bottom) Bottom) (Imp Bottom Bottom))
bottom-out-step-5 = Intuitionistic.MP {(Imp Bottom Bottom)} {(Imp (Imp (Imp Bottom Bottom) Bottom) (Imp Bottom Bottom))} (Intuitionistic.K {(Imp Bottom Bottom)} {(Imp (Imp Bottom Bottom) Bottom)}) (bottom-out-step-4)

bottom-out-step-6 : Intuitionistic (Imp (Imp (Imp Bottom Bottom) Bottom) Bottom)
bottom-out-step-6 = Intuitionistic.MP {(Imp (Imp (Imp Bottom Bottom) Bottom) (Imp Bottom Bottom))} {(Imp (Imp (Imp Bottom Bottom) Bottom) Bottom)} (bottom-out-step-2) (bottom-out-step-5)

bottom-out : Intuitionistic (Imp (Imp (Imp Bottom Bottom) Bottom) Bottom)
bottom-out = bottom-out-step-6


peirce-step-0 : {a : Formula} -> {b : Formula} -> Classical (Imp (Imp (Imp a b) a) (Imp (Imp (Imp a Bottom) Bottom) a))
peirce-step-0 {a} {b} = Classical.MP {(Imp (Imp (Imp a Bottom) Bottom) a)} {(Imp (Imp (Imp a b) a) (Imp (Imp (Imp a Bottom) Bottom) a))} (Classical.K {(Imp (Imp (Imp a Bottom) Bottom) a)} {(Imp (Imp a b) a)}) (Classical.DNE {a})

peirce-step-1 : {a : Formula} -> {b : Formula} -> Classical (Imp (Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) Bottom)) (Imp (Imp (Imp a b) a) a))
peirce-step-1 {a} {b} = Classical.MP {(Imp (Imp (Imp a b) a) (Imp (Imp (Imp a Bottom) Bottom) a))} {(Imp (Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) Bottom)) (Imp (Imp (Imp a b) a) a))} (Classical.S {(Imp (Imp a b) a)} {(Imp (Imp a Bottom) Bottom)} {a}) (peirce-step-0 {a} {b})

peirce-step-2 : {a : Formula} -> {b : Formula} -> Classical (Imp (Imp (Imp a Bottom) (Imp (Imp a Bottom) (Imp a Bottom))) (Imp (Imp a Bottom) (Imp a Bottom)))
peirce-step-2 {a} {b} = Classical.MP {(Imp (Imp a Bottom) (Imp (Imp (Imp a Bottom) (Imp a Bottom)) (Imp a Bottom)))} {(Imp (Imp (Imp a Bottom) (Imp (Imp a Bottom) (Imp a Bottom))) (Imp (Imp a Bottom) (Imp a Bottom)))} (Classical.S {(Imp a Bottom)} {(Imp (Imp a Bottom) (Imp a Bottom))} {(Imp a Bottom)}) (Classical.K {(Imp a Bottom)} {(Imp (Imp a Bottom) (Imp a Bottom))})

peirce-step-3 : {a : Formula} -> {b : Formula} -> Classical (Imp (Imp a Bottom) (Imp a Bottom))
peirce-step-3 {a} {b} = Classical.MP {(Imp (Imp a Bottom) (Imp (Imp a Bottom) (Imp a Bottom)))} {(Imp (Imp a Bottom) (Imp a Bottom))} (peirce-step-2 {a} {b}) (Classical.K {(Imp a Bottom)} {(Imp a Bottom)})

peirce-step-4 : {a : Formula} -> {b : Formula} -> Classical (Imp (Imp (Imp a Bottom) a) (Imp (Imp a Bottom) Bottom))
peirce-step-4 {a} {b} = Classical.MP {(Imp (Imp a Bottom) (Imp a Bottom))} {(Imp (Imp (Imp a Bottom) a) (Imp (Imp a Bottom) Bottom))} (Classical.S {(Imp a Bottom)} {a} {Bottom}) (peirce-step-3 {a} {b})

peirce-step-5 : {a : Formula} -> {b : Formula} -> Classical (Imp (Imp (Imp a b) a) (Imp (Imp (Imp a Bottom) a) (Imp (Imp a Bottom) Bottom)))
peirce-step-5 {a} {b} = Classical.MP {(Imp (Imp (Imp a Bottom) a) (Imp (Imp a Bottom) Bottom))} {(Imp (Imp (Imp a b) a) (Imp (Imp (Imp a Bottom) a) (Imp (Imp a Bottom) Bottom)))} (Classical.K {(Imp (Imp (Imp a Bottom) a) (Imp (Imp a Bottom) Bottom))} {(Imp (Imp a b) a)}) (peirce-step-4 {a} {b})

peirce-step-6 : {a : Formula} -> {b : Formula} -> Classical (Imp (Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) a)) (Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) Bottom)))
peirce-step-6 {a} {b} = Classical.MP {(Imp (Imp (Imp a b) a) (Imp (Imp (Imp a Bottom) a) (Imp (Imp a Bottom) Bottom)))} {(Imp (Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) a)) (Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) Bottom)))} (Classical.S {(Imp (Imp a b) a)} {(Imp (Imp a Bottom) a)} {(Imp (Imp a Bottom) Bottom)}) (peirce-step-5 {a} {b})

peirce-step-7 : {a : Formula} -> {b : Formula} -> Classical (Imp (Imp (Imp a b) a) (Imp (Imp (Imp a Bottom) (Imp (Imp a b) a)) (Imp (Imp (Imp a Bottom) (Imp a b)) (Imp (Imp a Bottom) a))))
peirce-step-7 {a} {b} = Classical.MP {(Imp (Imp (Imp a Bottom) (Imp (Imp a b) a)) (Imp (Imp (Imp a Bottom) (Imp a b)) (Imp (Imp a Bottom) a)))} {(Imp (Imp (Imp a b) a) (Imp (Imp (Imp a Bottom) (Imp (Imp a b) a)) (Imp (Imp (Imp a Bottom) (Imp a b)) (Imp (Imp a Bottom) a))))} (Classical.K {(Imp (Imp (Imp a Bottom) (Imp (Imp a b) a)) (Imp (Imp (Imp a Bottom) (Imp a b)) (Imp (Imp a Bottom) a)))} {(Imp (Imp a b) a)}) (Classical.S {(Imp a Bottom)} {(Imp a b)} {a})

peirce-step-8 : {a : Formula} -> {b : Formula} -> Classical (Imp (Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) (Imp (Imp a b) a))) (Imp (Imp (Imp a b) a) (Imp (Imp (Imp a Bottom) (Imp a b)) (Imp (Imp a Bottom) a))))
peirce-step-8 {a} {b} = Classical.MP {(Imp (Imp (Imp a b) a) (Imp (Imp (Imp a Bottom) (Imp (Imp a b) a)) (Imp (Imp (Imp a Bottom) (Imp a b)) (Imp (Imp a Bottom) a))))} {(Imp (Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) (Imp (Imp a b) a))) (Imp (Imp (Imp a b) a) (Imp (Imp (Imp a Bottom) (Imp a b)) (Imp (Imp a Bottom) a))))} (Classical.S {(Imp (Imp a b) a)} {(Imp (Imp a Bottom) (Imp (Imp a b) a))} {(Imp (Imp (Imp a Bottom) (Imp a b)) (Imp (Imp a Bottom) a))}) (peirce-step-7 {a} {b})

peirce-step-9 : {a : Formula} -> {b : Formula} -> Classical (Imp (Imp (Imp a b) a) (Imp (Imp (Imp a Bottom) (Imp a b)) (Imp (Imp a Bottom) a)))
peirce-step-9 {a} {b} = Classical.MP {(Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) (Imp (Imp a b) a)))} {(Imp (Imp (Imp a b) a) (Imp (Imp (Imp a Bottom) (Imp a b)) (Imp (Imp a Bottom) a)))} (peirce-step-8 {a} {b}) (Classical.K {(Imp (Imp a b) a)} {(Imp a Bottom)})

peirce-step-10 : {a : Formula} -> {b : Formula} -> Classical (Imp (Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) (Imp a b))) (Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) a)))
peirce-step-10 {a} {b} = Classical.MP {(Imp (Imp (Imp a b) a) (Imp (Imp (Imp a Bottom) (Imp a b)) (Imp (Imp a Bottom) a)))} {(Imp (Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) (Imp a b))) (Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) a)))} (Classical.S {(Imp (Imp a b) a)} {(Imp (Imp a Bottom) (Imp a b))} {(Imp (Imp a Bottom) a)}) (peirce-step-9 {a} {b})

peirce-step-11 : {a : Formula} -> {b : Formula} -> Classical (Imp a (Imp Bottom b))
peirce-step-11 {a} {b} = Classical.MP {(Imp Bottom b)} {(Imp a (Imp Bottom b))} (Classical.K {(Imp Bottom b)} {a}) (Classical.Explosion {b})

peirce-step-12 : {a : Formula} -> {b : Formula} -> Classical (Imp (Imp a Bottom) (Imp a b))
peirce-step-12 {a} {b} = Classical.MP {(Imp a (Imp Bottom b))} {(Imp (Imp a Bottom) (Imp a b))} (Classical.S {a} {Bottom} {b}) (peirce-step-11 {a} {b})

peirce-step-13 : {a : Formula} -> {b : Formula} -> Classical (Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) (Imp a b)))
peirce-step-13 {a} {b} = Classical.MP {(Imp (Imp a Bottom) (Imp a b))} {(Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) (Imp a b)))} (Classical.K {(Imp (Imp a Bottom) (Imp a b))} {(Imp (Imp a b) a)}) (peirce-step-12 {a} {b})

peirce-step-14 : {a : Formula} -> {b : Formula} -> Classical (Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) a))
peirce-step-14 {a} {b} = Classical.MP {(Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) (Imp a b)))} {(Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) a))} (peirce-step-10 {a} {b}) (peirce-step-13 {a} {b})

peirce-step-15 : {a : Formula} -> {b : Formula} -> Classical (Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) Bottom))
peirce-step-15 {a} {b} = Classical.MP {(Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) a))} {(Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) Bottom))} (peirce-step-6 {a} {b}) (peirce-step-14 {a} {b})

peirce-step-16 : {a : Formula} -> {b : Formula} -> Classical (Imp (Imp (Imp a b) a) a)
peirce-step-16 {a} {b} = Classical.MP {(Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) Bottom))} {(Imp (Imp (Imp a b) a) a)} (peirce-step-1 {a} {b}) (peirce-step-15 {a} {b})

peirce : {a : Formula} -> {b : Formula} -> Classical (Imp (Imp (Imp a b) a) a)
peirce {a} {b} = peirce-step-16 {a} {b}
-- END GENERATED HILBERT TEMPLATES

-- Glivenko's algorithm: its result-membership and result-index contracts
-- are generated and certified in PRA, uniformly over the input derivation.
glivenko : Classical a -> Intuitionistic (nn a)
glivenko (Classical.K {a} {b}) = Intuitionistic.MP (double-negation-intro {Imp a (Imp b a)}) (Intuitionistic.K {a} {b})
glivenko (Classical.S {a} {b} {c}) = Intuitionistic.MP (double-negation-intro {Imp (Imp a (Imp b c)) (Imp (Imp a b) (Imp a c))}) (Intuitionistic.S {a} {b} {c})
glivenko (Classical.Explosion {a}) = Intuitionistic.MP (double-negation-intro {Imp Bottom a}) (Intuitionistic.Explosion {a})
glivenko (Classical.DNE {a}) = double-negation-dne {a}
glivenko (Classical.MP {a} {b} f x) = Intuitionistic.MP {nn a} {nn b} (Intuitionistic.MP {nn (Imp a b)} {Imp (nn a) (nn b)} (double-negation-mp {a} {b}) (glivenko f)) (glivenko x)

-- The finite witness transformation underlying Con(IPC) -> Con(CPC).
contradiction : Classical Bottom -> Intuitionistic Bottom
contradiction p = Intuitionistic.MP bottom-out (glivenko p)

-- The converse direction of theoremhood: IPC proves not-not A only if CPC
-- proves A. This is another proof transformation, not a reflection principle.
recover : {a : Formula} -> Intuitionistic (nn a) -> Classical a
recover {a} p = Classical.MP {nn a} {a} (Classical.DNE {a}) (embed p)

-- Observable computations for the talk demo. These count unfolded proof
-- nodes; the evaluator can share identical subderivations internally.
classical-size : Classical a -> Nat
classical-size (Classical.K {a} {b}) = 1
classical-size (Classical.S {a} {b} {c}) = 1
classical-size (Classical.Explosion {a}) = 1
classical-size (Classical.DNE {a}) = 1
classical-size (Classical.MP {a} {b} f x) = S (classical-size f + classical-size x)

intuitionistic-size : Intuitionistic a -> Nat
intuitionistic-size (Intuitionistic.K {a} {b}) = 1
intuitionistic-size (Intuitionistic.S {a} {b} {c}) = 1
intuitionistic-size (Intuitionistic.Explosion {a}) = 1
intuitionistic-size (Intuitionistic.MP {a} {b} f x) = S (intuitionistic-size f + intuitionistic-size x)

conclusion : Intuitionistic a -> Formula
conclusion (Intuitionistic.K {a} {b}) = Imp a (Imp b a)
conclusion (Intuitionistic.S {a} {b} {c}) = Imp (Imp a (Imp b c)) (Imp (Imp a b) (Imp a c))
conclusion (Intuitionistic.Explosion {a}) = Imp Bottom a
conclusion (Intuitionistic.MP {a} {b} f x) = b

-- Package the original and translated proofs together. Keeping the proof
-- input abstract here lets the checker reuse glivenko's uniform contract.
data Translation where
  Translated : {a : Formula} -> Classical a -> Intuitionistic (nn a) -> Translation

translation : Classical a -> Translation
translation p = Translated p (glivenko p)

demo-proofs : Nat -> Nat -> Translation
demo-proofs p q = translation (peirce {Atom p} {Atom q})

data Demo = Result Formula Nat Nat

-- Result <actual output conclusion> <input proof size> <output proof size>.
summary : Translation -> Demo
summary (Translated {a} input output) = Result (conclusion output) (classical-size input) (intuitionistic-size output)

demo : Nat -> Nat -> Demo
demo p q = summary (demo-proofs p q)
