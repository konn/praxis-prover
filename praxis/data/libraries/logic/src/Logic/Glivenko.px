module Logic.Glivenko where

-- The implication/bottom fragment of propositional logic.
data Formula = Atom Nat | Bottom | Imp Formula Formula

neg : Formula -> Formula
neg a = Imp a Bottom

nn : Formula -> Formula
nn a = neg (neg a)

-- Closed Hilbert derivations. Formula parameters are retained axiom witnesses;
-- MP checks that the conclusions of its two premises agree on the antecedent.
data Intuitionistic (a : Formula) where
  K : {a b : Formula} -> Intuitionistic (Imp a (Imp b a))
  S : {a b c : Formula} -> Intuitionistic (Imp (Imp a (Imp b c)) (Imp (Imp a b) (Imp a c)))
  Explosion : {a : Formula} -> Intuitionistic (Imp Bottom a)
  MP : {a b : Formula} -> Intuitionistic (Imp a b) -> Intuitionistic a -> Intuitionistic b

data Classical (a : Formula) where
  K : {a b : Formula} -> Classical (Imp a (Imp b a))
  S : {a b c : Formula} -> Classical (Imp (Imp a (Imp b c)) (Imp (Imp a b) (Imp a c)))
  Explosion : {a : Formula} -> Classical (Imp Bottom a)
  DNE : {a : Formula} -> Classical (Imp (Imp (Imp a Bottom) Bottom) a)
  MP : {a b : Formula} -> Classical (Imp a b) -> Classical a -> Classical b

identity : {a : Formula} -> Intuitionistic (Imp a a)
identity {a} = Intuitionistic.MP (Intuitionistic.MP (Intuitionistic.S {a} {Imp a a} {a}) (Intuitionistic.K {a} {Imp a a})) (Intuitionistic.K {a} {a})

-- The easy direction preserves the conclusion literally.
embed : Intuitionistic a -> Classical a
embed (Intuitionistic.K {a} {b}) = Classical.K {a} {b}
embed (Intuitionistic.S {a} {b} {c}) = Classical.S {a} {b} {c}
embed (Intuitionistic.Explosion {a}) = Classical.Explosion {a}
embed (Intuitionistic.MP {a} {b} f x) = Classical.MP {a} {b} (embed f) (embed x)

