double-negation-dne : {a : Formula} -> Intuitionistic (((((a :=> Bottom) :=> Bottom) :=> a) :=> Bottom) :=> Bottom)
double-negation-dne {a} =
  Intuitionistic.S {(((a :=> Bottom) :=> Bottom) :=> a) :=> Bottom} {((a :=> Bottom) :=> Bottom) :=> a} {Bottom}
    :@ (Intuitionistic.S {(((a :=> Bottom) :=> Bottom) :=> a) :=> Bottom} {((((a :=> Bottom) :=> Bottom) :=> a) :=> Bottom) :=> (((a :=> Bottom) :=> Bottom) :=> a) :=> Bottom} {(((a :=> Bottom) :=> Bottom) :=> a) :=> Bottom}
          :@ Intuitionistic.K {(((a :=> Bottom) :=> Bottom) :=> a) :=> Bottom} {((((a :=> Bottom) :=> Bottom) :=> a) :=> Bottom) :=> (((a :=> Bottom) :=> Bottom) :=> a) :=> Bottom}
          :@ Intuitionistic.K {(((a :=> Bottom) :=> Bottom) :=> a) :=> Bottom} {(((a :=> Bottom) :=> Bottom) :=> a) :=> Bottom})
