          (Intuitionistic.K {(Imp (Imp (Imp (Imp a Bottom) Bottom) Bottom) (Imp (Imp (Imp a Bottom) Bottom) a))} {(Imp (Imp (Imp (Imp a Bottom) Bottom) a) Bottom)})
          (Intuitionistic.MP
            (Intuitionistic.S {(Imp (Imp a Bottom) Bottom)} {Bottom} {a})
            (Intuitionistic.MP
              (Intuitionistic.K {(Imp Bottom a)} {(Imp (Imp a Bottom) Bottom)})
              (Intuitionistic.Explosion {a})))))
      (double-negation-dne-part-2 {a})))


bottom-out : Intuitionistic (Imp (Imp (Imp Bottom Bottom) Bottom) Bottom)
bottom-out =
  (Intuitionistic.MP
    (Intuitionistic.MP
      (Intuitionistic.S {(Imp (Imp Bottom Bottom) Bottom)} {(Imp Bottom Bottom)} {Bottom})
      (Intuitionistic.MP
        (Intuitionistic.MP
          (Intuitionistic.S {(Imp (Imp Bottom Bottom) Bottom)} {(Imp (Imp (Imp Bottom Bottom) Bottom) (Imp (Imp Bottom Bottom) Bottom))} {(Imp (Imp Bottom Bottom) Bottom)})
          (Intuitionistic.K {(Imp (Imp Bottom Bottom) Bottom)} {(Imp (Imp (Imp Bottom Bottom) Bottom) (Imp (Imp Bottom Bottom) Bottom))}))
        (Intuitionistic.K {(Imp (Imp Bottom Bottom) Bottom)} {(Imp (Imp Bottom Bottom) Bottom)})))
    (Intuitionistic.MP
      (Intuitionistic.K {(Imp Bottom Bottom)} {(Imp (Imp Bottom Bottom) Bottom)})
      (Intuitionistic.MP
        (Intuitionistic.MP
          (Intuitionistic.S {Bottom} {(Imp Bottom Bottom)} {Bottom})
          (Intuitionistic.K {Bottom} {(Imp Bottom Bottom)}))
        (Intuitionistic.K {Bottom} {Bottom}))))


peirce-part-1 : {a : Formula} -> {b : Formula} -> Classical (Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) a))
peirce-part-1 {a} {b} =
  (Classical.MP
    (Classical.MP
      (Classical.S {(Imp (Imp a b) a)} {(Imp (Imp a Bottom) (Imp a b))} {(Imp (Imp a Bottom) a)})
      (Classical.MP
        (Classical.MP
          (Classical.S {(Imp (Imp a b) a)} {(Imp (Imp a Bottom) (Imp (Imp a b) a))} {(Imp (Imp (Imp a Bottom) (Imp a b)) (Imp (Imp a Bottom) a))})
          (Classical.MP
            (Classical.K {(Imp (Imp (Imp a Bottom) (Imp (Imp a b) a)) (Imp (Imp (Imp a Bottom) (Imp a b)) (Imp (Imp a Bottom) a)))} {(Imp (Imp a b) a)})
            (Classical.S {(Imp a Bottom)} {(Imp a b)} {a})))
        (Classical.K {(Imp (Imp a b) a)} {(Imp a Bottom)})))
    (Classical.MP
      (Classical.K {(Imp (Imp a Bottom) (Imp a b))} {(Imp (Imp a b) a)})
      (Classical.MP
        (Classical.S {a} {Bottom} {b})
        (Classical.MP (Classical.K {(Imp Bottom b)} {a}) (Classical.Explosion {b})))))

peirce-part-2 : {a : Formula} -> {b : Formula} -> Classical (Imp (Imp (Imp a b) a) (Imp (Imp a Bottom) Bottom))
peirce-part-2 {a} {b} =
  (Classical.MP
    (Classical.MP
      (Classical.S {(Imp (Imp a b) a)} {(Imp (Imp a Bottom) a)} {(Imp (Imp a Bottom) Bottom)})
      (Classical.MP
        (Classical.K {(Imp (Imp (Imp a Bottom) a) (Imp (Imp a Bottom) Bottom))} {(Imp (Imp a b) a)})
        (Classical.MP
          (Classical.S {(Imp a Bottom)} {a} {Bottom})
          (Classical.MP
            (Classical.MP
              (Classical.S {(Imp a Bottom)} {(Imp (Imp a Bottom) (Imp a Bottom))} {(Imp a Bottom)})
              (Classical.K {(Imp a Bottom)} {(Imp (Imp a Bottom) (Imp a Bottom))}))
            (Classical.K {(Imp a Bottom)} {(Imp a Bottom)})))))
    (peirce-part-1 {a} {b}))

peirce : {a : Formula} -> {b : Formula} -> Classical (Imp (Imp (Imp a b) a) a)
peirce {a} {b} =
  (Classical.MP
    (Classical.MP
      (Classical.S {(Imp (Imp a b) a)} {(Imp (Imp a Bottom) Bottom)} {a})
      (Classical.MP
        (Classical.K {(Imp (Imp (Imp a Bottom) Bottom) a)} {(Imp (Imp a b) a)})
        (Classical.DNE {a})))
    (peirce-part-2 {a} {b}))
-- END GENERATED HILBERT TEMPLATES

-- The namespace is independent of the selected theory. Leaving the block
-- exposes ClassicalExamples.peirce-law as a Classical derivation schema.
module ClassicalExamples where
  internal Classical where
    peirce-law : {a b : Formula} -> Imp (Imp (Imp a b) a) a
    peirce-law {a} {b} = by
      exact peirce {a} {b}

-- Glivenko's algorithm: its result-membership and result-index contracts
-- are generated and certified in PRA, uniformly over the input derivation.
glivenko : Classical a -> Intuitionistic (nn a)
glivenko (Classical.K {a} {b}) = Intuitionistic.MP (double-negation-intro {Imp a (Imp b a)}) (Intuitionistic.K {a} {b})
glivenko (Classical.S {a} {b} {c}) = Intuitionistic.MP (double-negation-intro {Imp (Imp a (Imp b c)) (Imp (Imp a b) (Imp a c))}) (Intuitionistic.S {a} {b} {c})
glivenko (Classical.Explosion {a}) = Intuitionistic.MP (double-negation-intro {Imp Bottom a}) (Intuitionistic.Explosion {a})
glivenko (Classical.DNE {a}) = double-negation-dne {a}
glivenko (Classical.MP {a} {b} f x) = Intuitionistic.MP {nn a} {nn b} (Intuitionistic.MP {nn (Imp a b)} {Imp (nn a) (nn b)} (double-negation-mp {a} {b}) (glivenko f)) (glivenko x)

-- The finite witness transformation underlying Con(IPC) -> Con(CPC).
contradiction : Classical Bottom -> Intuitionistic Bottom
contradiction p = Intuitionistic.MP bottom-out (glivenko p)

-- The converse direction of theoremhood: IPC proves not-not A only if CPC
-- proves A. This is another proof transformation, not a reflection principle.
recover : {a : Formula} -> Intuitionistic (nn a) -> Classical a
recover {a} p = Classical.MP {nn a} {a} (Classical.DNE {a}) (embed p)

-- Observable computations for the talk demo. These count unfolded proof
-- nodes; the evaluator can share identical subderivations internally.
classical-size : Classical a -> Nat
classical-size (Classical.K {a} {b}) = 1
classical-size (Classical.S {a} {b} {c}) = 1
classical-size (Classical.Explosion {a}) = 1
classical-size (Classical.DNE {a}) = 1
classical-size (Classical.MP {a} {b} f x) = S (classical-size f + classical-size x)

intuitionistic-size : Intuitionistic a -> Nat
intuitionistic-size (Intuitionistic.K {a} {b}) = 1
intuitionistic-size (Intuitionistic.S {a} {b} {c}) = 1
intuitionistic-size (Intuitionistic.Explosion {a}) = 1
intuitionistic-size (Intuitionistic.MP {a} {b} f x) = S (intuitionistic-size f + intuitionistic-size x)

conclusion : Intuitionistic a -> Formula
conclusion (Intuitionistic.K {a} {b}) = Imp a (Imp b a)
conclusion (Intuitionistic.S {a} {b} {c}) = Imp (Imp a (Imp b c)) (Imp (Imp a b) (Imp a c))
conclusion (Intuitionistic.Explosion {a}) = Imp Bottom a
conclusion (Intuitionistic.MP {a} {b} f x) = b

-- Package the original and translated proofs together. Keeping the proof
-- input abstract here lets the checker reuse glivenko's uniform contract.
data Translation where
  Translated : {a : Formula} -> Classical a -> Intuitionistic (nn a) -> Translation

translation : Classical a -> Translation
translation p = Translated p (glivenko p)

demo-proofs : Nat -> Nat -> Translation
demo-proofs p q = translation (ClassicalExamples.peirce-law {Atom p} {Atom q})

data Demo = Result Formula Nat Nat

-- Result <actual output conclusion> <input proof size> <output proof size>.
summary : Translation -> Demo
summary (Translated {a} input output) = Result (conclusion output) (classical-size input) (intuitionistic-size output)

demo : Nat -> Nat -> Demo
demo p q = summary (demo-proofs p q)
