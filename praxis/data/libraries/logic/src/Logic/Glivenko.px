module Logic.Glivenko where

-- The implication/bottom fragment of propositional logic. Implication is the
-- right-associative infix constructor :=>, so a :=> b :=> c is a :=> (b :=> c).
data Formula = Atom Nat | Bottom | Formula :=> Formula

infixr 5 :=>

neg : Formula -> Formula
neg a = a :=> Bottom

nn : Formula -> Formula
nn a = neg (neg a)

-- Closed Hilbert derivations. Formula parameters are retained axiom witnesses;
-- Modus ponens, f :@ x, checks that the conclusions of its two premises agree
-- on the antecedent.
data Intuitionistic (a : Formula) where
  K : {a b : Formula} -> Intuitionistic (a :=> b :=> a)
  S : {a b c : Formula} -> Intuitionistic ((a :=> b :=> c) :=> (a :=> b) :=> a :=> c)
  Explosion : {a : Formula} -> Intuitionistic (Bottom :=> a)
  (:@) : {a b : Formula} -> Intuitionistic (a :=> b) -> Intuitionistic a -> Intuitionistic b

data Classical (a : Formula) where
  K : {a b : Formula} -> Classical (a :=> b :=> a)
  S : {a b c : Formula} -> Classical ((a :=> b :=> c) :=> (a :=> b) :=> a :=> c)
  Explosion : {a : Formula} -> Classical (Bottom :=> a)
  DNE : {a : Formula} -> Classical (((a :=> Bottom) :=> Bottom) :=> a)
  (:@) : {a b : Formula} -> Classical (a :=> b) -> Classical a -> Classical b

infixl 9 :@

-- Proof schemata built by construction tactics in an ordinary definition:
-- apply modus ponens, then construct its two premises in turn. (:@) is found
-- by the expected type; K and S are qualified, since both calculi have them
-- and a bare S is the successor.
identity : {a : Formula} -> Intuitionistic (a :=> a)
identity {a} = by
  apply (:@)
  {
    apply (:@)
    { exact Intuitionistic.S {a} {a :=> a} {a} }
    { exact Intuitionistic.K {a} {a :=> a} }
  }
  { exact Intuitionistic.K {a} {a} }

-- The easy direction preserves the conclusion literally.
embed : Intuitionistic a -> Classical a
embed (Intuitionistic.K {a} {b}) = Classical.K {a} {b}
embed (Intuitionistic.S {a} {b} {c}) = Classical.S {a} {b} {c}
embed (Intuitionistic.Explosion {a}) = Classical.Explosion {a}
embed (f :@ x) = embed f :@ embed x

-- Bracket abstraction: the deduction theorem for the Hilbert calculus, as a
-- function on derivations. A derivation under hypotheses is open; its
-- hypotheses are typed de Bruijn indices into a context, the newest last.
-- Abstracting the newest one turns a derivation of b under g :> a into one
-- of a :=> b under g, built from K, S and modus ponens alone, and a closed
-- one is an ordinary derivation. Every index contract here is certified, so
-- the derivations below are checked by construction.
data Context = Empty | Context :> Formula

infixl 4 :>

-- Here is the newest hypothesis, There Here the one before it, and so on.
data Member (a : Formula) (g : Context) where
  Here : {g : Context} -> {a : Formula} -> Member a (g :> a)
  There : {g : Context} -> {a b : Formula} -> Member a g -> Member a (g :> b)

data Open (g : Context) (a : Formula) where
  Hyp : {g : Context} -> {a : Formula} -> Member a g -> Open g a
  Lift : {g : Context} -> {a : Formula} -> Intuitionistic a -> Open g a
  (:@) : {g : Context} -> {a b : Formula} -> Open g (a :=> b) -> Open g a -> Open g b

-- A derivation under g :> a, each node marked by whether it uses the newest
-- hypothesis a, in the co-de Bruijn style: an unused part is an Open
-- derivation under g, and the hypothesis itself is Var.
data Use (g : Context) (a : Formula) (b : Formula) where
  Unused : {g : Context} -> {a b : Formula} -> Open g b -> Use g a b
  Var : {g : Context} -> {a : Formula} -> Use g a a
  Apply : {g : Context} -> {a b c : Formula} -> Use g a (c :=> b) -> Use g a c -> Use g a b

hypothesis : {g : Context} -> {a b : Formula} -> Member b (g :> a) -> Use g a b
hypothesis {g} {a} Here = Var
hypothesis {g} {a} (There m) = Unused (Hyp m)

-- Modus ponens, its premises marked: unused when both are.
apply-unused : {b a : Formula} -> {g : Context} -> {c : Formula} -> Open g (c :=> b) -> Use g a c -> Use g a b
apply-unused {b} {a} f (Unused x) = Unused (f :@ x)
apply-unused {b} {a} f Var = Apply (Unused f) Var
apply-unused {b} {a} f (Apply y z) = Apply (Unused f) (Apply y z)

apply-use : {b : Formula} -> {g : Context} -> {a c : Formula} -> Use g a (c :=> b) -> Use g a c -> Use g a b
apply-use {b} (Unused f) u = apply-unused f u
apply-use {b} Var u = Apply Var u
apply-use {b} (Apply f x) u = Apply (Apply f x) u

annotate : {g : Context} -> {a b : Formula} -> Open (g :> a) b -> Use g a b
annotate {g} {a} (Hyp m) = hypothesis m
annotate {g} {a} (Lift p) = Unused (Lift p)
annotate {g} {a} (f :@ x) = apply-use (annotate f) (annotate x)

s-step : {g : Context} -> {a b c : Formula} -> Open g (a :=> c :=> b) -> Open g (a :=> c) -> Open g (a :=> b)
s-step {g} {a} {b} {c} af ax = Lift (Intuitionistic.S {a} {c} {b}) :@ af :@ ax

-- An application f x whose argument uses the hypothesis a: f itself when x
-- is a, as eta reduction gives; S otherwise.
combine-unused : {g : Context} -> {a b c : Formula} -> Open g (c :=> b) -> Use g a c -> Open g (a :=> c :=> b) -> Open g (a :=> c) -> Open g (a :=> b)
combine-unused {g} {a} {b} {c} f (Unused y) af ax = s-step {g} {a} {b} {c} af ax
combine-unused {g} {a} {b} {c} f Var af ax = f
combine-unused {g} {a} {b} {c} f (Apply y z) af ax = s-step {g} {a} {b} {c} af ax

combine : {g : Context} -> {a b c : Formula} -> Use g a (c :=> b) -> Use g a c -> Open g (a :=> c :=> b) -> Open g (a :=> c) -> Open g (a :=> b)
combine {g} {a} {b} {c} (Unused f) x af ax = combine-unused {g} {a} {b} {c} f x af ax
combine {g} {a} {b} {c} Var x af ax = s-step {g} {a} {b} {c} af ax
combine {g} {a} {b} {c} (Apply y z) x af ax = s-step {g} {a} {b} {c} af ax

-- K for a part not using the hypothesis, the identity for the hypothesis,
-- and for an application, eta or S over the abstracted premises.
abstract : Use g a b -> Open g (a :=> b)
abstract (Unused {g} {a} {b} d) = Lift (Intuitionistic.K {b} {a}) :@ d
abstract (Var {g} {a}) = Lift (identity {a})
abstract (Apply {g} {a} {b} {c} f x) = combine {g} {a} {b} {c} f x (abstract f) (abstract x)

-- The deduction theorem: discharge the newest hypothesis.
deduction : {g : Context} -> {a b : Formula} -> Open (g :> a) b -> Open g (a :=> b)
deduction {g} {a} d = abstract (annotate {g} {a} d)

no-member : Member a Empty -> Intuitionistic a
no-member ()

-- A derivation under no hypotheses.
close : Open Empty a -> Intuitionistic a
close (Hyp m) = no-member m
close (Lift p) = p
close (f :@ x) = close f :@ close x

-- The double-negation lemmas Glivenko's algorithm uses, each a lambda term
-- read as an open derivation: deduction is lambda, Hyp a variable, :@
-- application. Hyp Here is the innermost bound variable.

-- \x. \n. n x
double-negation-intro : {a : Formula} -> Intuitionistic (a :=> (a :=> Bottom) :=> Bottom)
double-negation-intro {a} = close (deduction (deduction (Hyp Here :@ Hyp (There Here))))

-- \f. \p. \nb. f (\g. p (\x. nb (g x)))
double-negation-mp : {a : Formula} -> {b : Formula} -> Intuitionistic ((((a :=> b) :=> Bottom) :=> Bottom) :=> ((a :=> Bottom) :=> Bottom) :=> (b :=> Bottom) :=> Bottom)
double-negation-mp {a} {b} = close (deduction (deduction (deduction (
  Hyp (There (There Here)) :@ deduction (
    Hyp (There (There Here)) :@ deduction (
      Hyp (There (There Here)) :@ (Hyp (There Here) :@ Hyp Here)))))))

-- \h. h (\n. Explosion (n (\x. h (\m. x))))
double-negation-dne : {a : Formula} -> Intuitionistic (((((a :=> Bottom) :=> Bottom) :=> a) :=> Bottom) :=> Bottom)
double-negation-dne {a} = close (deduction (
  Hyp Here :@ deduction (
    Lift (Intuitionistic.Explosion {a}) :@ (Hyp Here :@ deduction (
      Hyp (There (There Here)) :@ deduction (Hyp (There Here)))))))

-- \n. n (\z. z)
bottom-out : Intuitionistic (((Bottom :=> Bottom) :=> Bottom) :=> Bottom)
bottom-out = close (deduction (Hyp Here :@ deduction (Hyp Here)))

-- \f. DNE (\na. na (f (\x. Explosion (na x)))): the body under f applies
-- the classical DNE, closed, to an intuitionistic part, so its abstraction
-- is S (K DNE) of that part's, built in the classical calculus.
peirce : {a : Formula} -> {b : Formula} -> Classical (((a :=> b) :=> a) :=> a)
peirce {a} {b} =
  Classical.S {(a :=> b) :=> a} {(a :=> Bottom) :=> Bottom} {a}
    :@ (Classical.K {((a :=> Bottom) :=> Bottom) :=> a} {(a :=> b) :=> a} :@ Classical.DNE {a})
    :@ embed (close (deduction (deduction (
      Hyp Here :@ (Hyp (There Here) :@ deduction (
        Lift (Intuitionistic.Explosion {b}) :@ (Hyp (There Here) :@ Hyp Here)))))))

-- The namespace is independent of the selected theory. Leaving the block
-- exposes ClassicalExamples.peirce-law as a Classical derivation schema.
module ClassicalExamples where
  internal Classical where
    peirce-law : {a b : Formula} -> ((a :=> b) :=> a) :=> a
    peirce-law {a} {b} = by
      exact peirce {a} {b}

-- Glivenko's algorithm: its result-membership and result-index contracts
-- are generated and certified in PRA, uniformly over the input derivation.
glivenko : Classical a -> Intuitionistic (nn a)
glivenko (Classical.K {a} {b}) = double-negation-intro {a :=> b :=> a} :@ Intuitionistic.K {a} {b}
glivenko (Classical.S {a} {b} {c}) = double-negation-intro {(a :=> b :=> c) :=> (a :=> b) :=> a :=> c} :@ Intuitionistic.S {a} {b} {c}
glivenko (Classical.Explosion {a}) = double-negation-intro {Bottom :=> a} :@ Intuitionistic.Explosion {a}
glivenko (Classical.DNE {a}) = double-negation-dne {a}
glivenko ((:@) {a} {b} f x) = double-negation-mp {a} {b} :@ glivenko f :@ glivenko x

-- The finite witness transformation underlying Con(IPC) -> Con(CPC).
contradiction : Classical Bottom -> Intuitionistic Bottom
contradiction p = bottom-out :@ glivenko p

-- The converse direction of theoremhood: IPC proves not-not A only if CPC
-- proves A. This is another proof transformation, not a reflection principle.
recover : {a : Formula} -> Intuitionistic (nn a) -> Classical a
recover {a} p = Classical.DNE {a} :@ embed p

-- Observable computations for the talk demo. These count unfolded proof
-- nodes; the evaluator can share identical subderivations internally.
classical-size : Classical a -> Nat
classical-size (Classical.K {a} {b}) = 1
classical-size (Classical.S {a} {b} {c}) = 1
classical-size (Classical.Explosion {a}) = 1
classical-size (Classical.DNE {a}) = 1
classical-size (f :@ x) = S (classical-size f + classical-size x)

intuitionistic-size : Intuitionistic a -> Nat
intuitionistic-size (Intuitionistic.K {a} {b}) = 1
intuitionistic-size (Intuitionistic.S {a} {b} {c}) = 1
intuitionistic-size (Intuitionistic.Explosion {a}) = 1
intuitionistic-size (f :@ x) = S (intuitionistic-size f + intuitionistic-size x)

-- Embedding an intuitionistic proof into the classical calculus preserves its
-- size: a calculation for modus ponens, the induction hypotheses at the premises.
embed-size : (p : Intuitionistic a)
  -> classical-size (embed p) ≡ intuitionistic-size p
embed-size (Intuitionistic.K {a} {b}) = rfl
embed-size (Intuitionistic.S {a} {b} {c}) = rfl
embed-size (Intuitionistic.Explosion {a}) = rfl
embed-size (f :@ x) = calc
  classical-size (embed (f :@ x))
  = classical-size (embed f :@ embed x)
  = S (classical-size (embed f) + classical-size (embed x))
  = S (intuitionistic-size f + classical-size (embed x))
      := cong (embed-size f)
  = S (intuitionistic-size f + intuitionistic-size x)
      := cong (embed-size x)
  = intuitionistic-size (f :@ x)

conclusion : Intuitionistic a -> Formula
conclusion (Intuitionistic.K {a} {b}) = a :=> b :=> a
conclusion (Intuitionistic.S {a} {b} {c}) = (a :=> b :=> c) :=> (a :=> b) :=> a :=> c
conclusion (Intuitionistic.Explosion {a}) = Bottom :=> a
conclusion ((:@) {a} {b} f x) = b

-- Package the original and translated proofs together. Keeping the proof
-- input abstract here lets the checker reuse glivenko's uniform contract.
data Translation where
  Translated : {a : Formula} -> Classical a -> Intuitionistic (nn a) -> Translation

translation : Classical a -> Translation
translation p = Translated p (glivenko p)

demo-proofs : Nat -> Nat -> Translation
demo-proofs p q = translation (ClassicalExamples.peirce-law {Atom p} {Atom q})

data Demo = Result Formula Nat Nat

-- Result <actual output conclusion> <input proof size> <output proof size>.
summary : Translation -> Demo
summary (Translated {a} input output) = Result (conclusion output) (classical-size input) (intuitionistic-size output)

demo : Nat -> Nat -> Demo
demo p q = summary (demo-proofs p q)
