      (Intuitionistic.S {(Imp (Imp (Imp a b) Bottom) Bottom)} {(Imp (Imp (Imp b Bottom) (Imp (Imp a b) Bottom)) (Imp (Imp b Bottom) Bottom))} {(Imp (Imp (Imp a Bottom) Bottom) (Imp (Imp (Imp b Bottom) (Imp (Imp a b) Bottom)) (Imp (Imp b Bottom) Bottom)))})
      (Intuitionistic.MP
        (Intuitionistic.K {(Imp (Imp (Imp (Imp b Bottom) (Imp (Imp a b) Bottom)) (Imp (Imp b Bottom) Bottom)) (Imp (Imp (Imp a Bottom) Bottom) (Imp (Imp (Imp b Bottom) (Imp (Imp a b) Bottom)) (Imp (Imp b Bottom) Bottom))))} {(Imp (Imp (Imp a b) Bottom) Bottom)})
        (Intuitionistic.K {(Imp (Imp (Imp b Bottom) (Imp (Imp a b) Bottom)) (Imp (Imp b Bottom) Bottom))} {(Imp (Imp a Bottom) Bottom)})))
    (Intuitionistic.MP
      (Intuitionistic.MP
        (Intuitionistic.S {(Imp (Imp (Imp a b) Bottom) Bottom)} {(Imp (Imp b Bottom) (Imp (Imp (Imp a b) Bottom) Bottom))} {(Imp (Imp (Imp b Bottom) (Imp (Imp a b) Bottom)) (Imp (Imp b Bottom) Bottom))})
        (Intuitionistic.MP
          (Intuitionistic.K {(Imp (Imp (Imp b Bottom) (Imp (Imp (Imp a b) Bottom) Bottom)) (Imp (Imp (Imp b Bottom) (Imp (Imp a b) Bottom)) (Imp (Imp b Bottom) Bottom)))} {(Imp (Imp (Imp a b) Bottom) Bottom)})
          (Intuitionistic.S {(Imp b Bottom)} {(Imp (Imp a b) Bottom)} {Bottom})))
      (Intuitionistic.K {(Imp (Imp (Imp a b) Bottom) Bottom)} {(Imp b Bottom)})))

double-negation-mp-part-2 : {a : Formula} -> {b : Formula} -> Intuitionistic (Imp (Imp (Imp a Bottom) Bottom) (Imp (Imp b Bottom) (Imp (Imp (Imp a b) (Imp a Bottom)) (Imp (Imp a b) Bottom))))
double-negation-mp-part-2 {a} {b} =
  (Intuitionistic.MP
    (Intuitionistic.MP
      (Intuitionistic.S {(Imp (Imp a Bottom) Bottom)} {(Imp (Imp (Imp a b) (Imp a Bottom)) (Imp (Imp a b) Bottom))} {(Imp (Imp b Bottom) (Imp (Imp (Imp a b) (Imp a Bottom)) (Imp (Imp a b) Bottom)))})
      (Intuitionistic.MP
        (Intuitionistic.K {(Imp (Imp (Imp (Imp a b) (Imp a Bottom)) (Imp (Imp a b) Bottom)) (Imp (Imp b Bottom) (Imp (Imp (Imp a b) (Imp a Bottom)) (Imp (Imp a b) Bottom))))} {(Imp (Imp a Bottom) Bottom)})
        (Intuitionistic.K {(Imp (Imp (Imp a b) (Imp a Bottom)) (Imp (Imp a b) Bottom))} {(Imp b Bottom)})))
    (Intuitionistic.MP
      (Intuitionistic.MP
        (Intuitionistic.S {(Imp (Imp a Bottom) Bottom)} {(Imp (Imp a b) (Imp (Imp a Bottom) Bottom))} {(Imp (Imp (Imp a b) (Imp a Bottom)) (Imp (Imp a b) Bottom))})
