    :@ (Intuitionistic.K {(((a :=> b) :=> a :=> Bottom) :=> (a :=> b) :=> Bottom) :=> (b :=> Bottom) :=> ((a :=> b) :=> a :=> Bottom) :=> (a :=> b) :=> Bottom} {(a :=> Bottom) :=> Bottom}
