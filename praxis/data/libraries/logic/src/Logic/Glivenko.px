double-negation-intro : {a : Formula} -> Intuitionistic (a :=> (a :=> Bottom) :=> Bottom)
double-negation-intro {a} =
  Intuitionistic.S {a} {(a :=> Bottom) :=> a} {(a :=> Bottom) :=> Bottom}
    :@ (Intuitionistic.K {((a :=> Bottom) :=> a) :=> (a :=> Bottom) :=> Bottom} {a}
          :@ (Intuitionistic.S {a :=> Bottom} {a} {Bottom}
                :@ (Intuitionistic.S {a :=> Bottom} {(a :=> Bottom) :=> a :=> Bottom} {a :=> Bottom}
                      :@ Intuitionistic.K {a :=> Bottom} {(a :=> Bottom) :=> a :=> Bottom}
                      :@ Intuitionistic.K {a :=> Bottom} {a :=> Bottom})))
    :@ Intuitionistic.K {a} {a :=> Bottom}


