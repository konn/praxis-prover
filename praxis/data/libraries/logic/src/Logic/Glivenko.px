module Logic.Glivenko where

-- The implication/bottom fragment of propositional logic. Implication is the
-- right-associative infix constructor :=>, so a :=> b :=> c is a :=> (b :=> c).
data Formula = Atom Nat | Bottom | Formula :=> Formula

infixr 5 :=>

neg : Formula -> Formula
neg a = a :=> Bottom

nn : Formula -> Formula
nn a = neg (neg a)

-- Closed Hilbert derivations. Formula parameters are retained axiom witnesses;
-- Modus ponens, f :@ x, checks that the conclusions of its two premises agree
-- on the antecedent.
data Intuitionistic (a : Formula) where
  K : {a b : Formula} -> Intuitionistic (a :=> b :=> a)
  S : {a b c : Formula} -> Intuitionistic ((a :=> b :=> c) :=> (a :=> b) :=> a :=> c)
  Explosion : {a : Formula} -> Intuitionistic (Bottom :=> a)
  (:@) : {a b : Formula} -> Intuitionistic (a :=> b) -> Intuitionistic a -> Intuitionistic b

data Classical (a : Formula) where
  K : {a b : Formula} -> Classical (a :=> b :=> a)
  S : {a b c : Formula} -> Classical ((a :=> b :=> c) :=> (a :=> b) :=> a :=> c)
  Explosion : {a : Formula} -> Classical (Bottom :=> a)
  DNE : {a : Formula} -> Classical (((a :=> Bottom) :=> Bottom) :=> a)
  (:@) : {a b : Formula} -> Classical (a :=> b) -> Classical a -> Classical b

infixl 9 :@

-- Proof schemata built by construction tactics in an ordinary definition:
-- apply modus ponens, then construct its two premises in turn. (:@) is found
-- by the expected type; K and S are qualified, since both calculi have them
-- and a bare S is the successor.
identity : {a : Formula} -> Intuitionistic (a :=> a)
identity {a} = by
  apply (:@)
  {
    apply (:@)
    { exact Intuitionistic.S {a} {a :=> a} {a} }
    { exact Intuitionistic.K {a} {a :=> a} }
  }
  { exact Intuitionistic.K {a} {a} }

-- The easy direction preserves the conclusion literally.
embed : Intuitionistic a -> Classical a
embed (Intuitionistic.K {a} {b}) = Classical.K {a} {b}
embed (Intuitionistic.S {a} {b} {c}) = Classical.S {a} {b} {c}
embed (Intuitionistic.Explosion {a}) = Classical.Explosion {a}
embed ((:@) {a} {b} f x) = embed f :@ embed x

