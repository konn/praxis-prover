          (Intuitionistic.K {(Imp (Imp (Imp a b) (Imp (Imp a Bottom) Bottom)) (Imp (Imp (Imp a b) (Imp a Bottom)) (Imp (Imp a b) Bottom)))} {(Imp (Imp a Bottom) Bottom)})
          (Intuitionistic.S {(Imp a b)} {(Imp a Bottom)} {Bottom})))
      (Intuitionistic.K {(Imp (Imp a Bottom) Bottom)} {(Imp a b)})))

double-negation-mp-part-3 : {a : Formula} -> {b : Formula} -> Intuitionistic (Imp (Imp (Imp a Bottom) Bottom) (Imp (Imp b Bottom) (Imp (Imp a b) Bottom)))
double-negation-mp-part-3 {a} {b} =
  (Intuitionistic.MP
    (Intuitionistic.MP
      (Intuitionistic.S {(Imp (Imp a Bottom) Bottom)} {(Imp (Imp b Bottom) (Imp (Imp a b) (Imp a Bottom)))} {(Imp (Imp b Bottom) (Imp (Imp a b) Bottom))})
