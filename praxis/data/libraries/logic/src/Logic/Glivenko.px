            (Intuitionistic.K {(Imp (Imp a (Imp b Bottom)) (Imp (Imp a b) (Imp a Bottom)))} {(Imp b Bottom)})
            (Intuitionistic.S {a} {b} {Bottom})))
        (Intuitionistic.K {(Imp b Bottom)} {a}))))

double-negation-mp : {a : Formula} -> {b : Formula} -> Intuitionistic (Imp (Imp (Imp (Imp a b) Bottom) Bottom) (Imp (Imp (Imp a Bottom) Bottom) (Imp (Imp b Bottom) Bottom)))
double-negation-mp {a} {b} =
  (Intuitionistic.MP
    (Intuitionistic.MP
      (Intuitionistic.S {(Imp (Imp (Imp a b) Bottom) Bottom)} {(Imp (Imp (Imp a Bottom) Bottom) (Imp (Imp b Bottom) (Imp (Imp a b) Bottom)))} {(Imp (Imp (Imp a Bottom) Bottom) (Imp (Imp b Bottom) Bottom))})
      (Intuitionistic.MP
        (Intuitionistic.MP
          (Intuitionistic.S {(Imp (Imp (Imp a b) Bottom) Bottom)} {(Imp (Imp (Imp a Bottom) Bottom) (Imp (Imp (Imp b Bottom) (Imp (Imp a b) Bottom)) (Imp (Imp b Bottom) Bottom)))} {(Imp (Imp (Imp (Imp a Bottom) Bottom) (Imp (Imp b Bottom) (Imp (Imp a b) Bottom))) (Imp (Imp (Imp a Bottom) Bottom) (Imp (Imp b Bottom) Bottom)))})
          (Intuitionistic.MP
            (Intuitionistic.K {(Imp (Imp (Imp (Imp a Bottom) Bottom) (Imp (Imp (Imp b Bottom) (Imp (Imp a b) Bottom)) (Imp (Imp b Bottom) Bottom))) (Imp (Imp (Imp (Imp a Bottom) Bottom) (Imp (Imp b Bottom) (Imp (Imp a b) Bottom))) (Imp (Imp (Imp a Bottom) Bottom) (Imp (Imp b Bottom) Bottom))))} {(Imp (Imp (Imp a b) Bottom) Bottom)})
            (Intuitionistic.S {(Imp (Imp a Bottom) Bottom)} {(Imp (Imp b Bottom) (Imp (Imp a b) Bottom))} {(Imp (Imp b Bottom) Bottom)})))
        (double-negation-mp-part-1 {a} {b})))
    (Intuitionistic.MP
      (Intuitionistic.K {(Imp (Imp (Imp a Bottom) Bottom) (Imp (Imp b Bottom) (Imp (Imp a b) Bottom)))} {(Imp (Imp (Imp a b) Bottom) Bottom)})
      (double-negation-mp-part-3 {a} {b})))


double-negation-dne-part-1 : {a : Formula} -> Intuitionistic (Imp (Imp (Imp (Imp (Imp a Bottom) Bottom) a) Bottom) (Imp a Bottom))
double-negation-dne-part-1 {a} =
  (Intuitionistic.MP
    (Intuitionistic.MP
      (Intuitionistic.S {(Imp (Imp (Imp (Imp a Bottom) Bottom) a) Bottom)} {(Imp a (Imp (Imp (Imp a Bottom) Bottom) a))} {(Imp a Bottom)})
