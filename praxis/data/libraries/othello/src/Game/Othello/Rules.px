module Game.Othello.Rules where

import "base" Data.Bool as B
import "base" Data.List as L
import "base" Data.Maybe as M
import Game.Othello.Board as C
open C using (Board, Square, Player, Cell, Offset)
open L using (List, Nil, (::), (<>))

data Direction = North | NorthEast | East | SouthEast | South | SouthWest | West | NorthWest
open Direction public

row-offset : Direction -> Offset
row-offset North = C.Back
row-offset NorthEast = C.Back
row-offset East = C.Stay
row-offset SouthEast = C.Forward
row-offset South = C.Forward
row-offset SouthWest = C.Forward
row-offset West = C.Stay
row-offset NorthWest = C.Back

column-offset : Direction -> Offset
column-offset North = C.Stay
column-offset NorthEast = C.Forward
column-offset East = C.Forward
column-offset SouthEast = C.Forward
column-offset South = C.Stay
column-offset SouthWest = C.Back
column-offset West = C.Back
column-offset NorthWest = C.Back

directions : List Direction
directions = North :: NorthEast :: East :: SouthEast :: South :: SouthWest :: West :: NorthWest :: Nil

private
  data Ray where
    Path : M.Maybe (Square) -> List (Square) -> Ray

  extend-ray : M.Maybe (Square) -> List (Square) -> Ray
  extend-ray M.Nothing xs = Path M.Nothing xs
  extend-ray (M.Just s) xs = Path (M.Just s) (s :: xs)

  advance-ray : Nat -> Direction -> M.Maybe (Square) -> List (Square) -> Ray
  advance-ray n d M.Nothing xs = Path M.Nothing xs
  advance-ray n d (M.Just s) xs = extend-ray (C.step n (row-offset d) (column-offset d) s) xs

  ray-step : Nat -> Direction -> Ray -> Ray
  ray-step n d (Path current xs) = advance-ray n d current xs

  ray-state : Nat -> Nat -> Direction -> Square -> Ray
  ray-state 0 n d s = Path (M.Just s) Nil
  ray-state (S k) n d s = ray-step n d (ray-state k n d s)

  ray-list : Ray -> List (Square)
  ray-list (Path current xs) = L.reverse xs

-- At most n steps reach every square on a ray. Stepping off the board
-- is absorbing, so truncated natural subtraction can never wrap an edge.
ray : Nat -> Direction -> Square -> List (Square)
ray n d s = ray-list (ray-state n n d s)

private
  data Capture where
    Unbracketed : Capture
    Bracketed : List (Square) -> Capture

  prepend-opponent : Square -> Capture -> Capture
  prepend-opponent s Unbracketed = Unbracketed
  prepend-opponent s (Bracketed xs) = Bracketed (s :: xs)

  scan-cell : Player -> Square -> Cell -> Capture -> Capture
  scan-cell p s C.Empty suffix = Unbracketed
  scan-cell p s (C.Disc q) suffix = B.choose (C.same-player p q) (Bracketed Nil) (prepend-opponent s suffix)

  scan-read : Player -> Square -> M.Maybe Cell -> Capture -> Capture
  scan-read p s M.Nothing suffix = Unbracketed
  scan-read p s (M.Just x) suffix = scan-cell p s x suffix

  scan : Player -> Board -> List (Square) -> Capture
  scan p b Nil = Unbracketed
  scan p b (s :: ss) = scan-read p s (C.read s b) (scan p b ss)

  captured : Capture -> List (Square)
  captured Unbracketed = Nil
  captured (Bracketed xs) = xs

-- Only a nonempty consecutive run of opponent discs followed by a
-- friendly disc is returned. An empty square or board edge cancels it.
captures-on : Player -> Board -> Square -> Direction -> List (Square)
captures-on p b s d = captured (scan p b (ray (C.size b) d s))

-- Closed-form capture along rays of length 2 or 3, useful for small boards.
is-disc : Player -> Cell -> B.Bool
is-disc p C.Empty = B.False
is-disc p (C.Disc q) = C.same-player p q

private
  ray-two-end : B.Bool -> a -> List a
  ray-two-end B.False s1 = Nil
  ray-two-end B.True s1 = s1 :: Nil

  ray-two-step : B.Bool -> Player -> a -> Cell -> List a
  ray-two-step B.False p s1 c2 = Nil
  ray-two-step B.True p s1 c2 = ray-two-end (is-disc p c2) s1

  ray-three-end : B.Bool -> a -> a -> List a
  ray-three-end B.False s1 s2 = Nil
  ray-three-end B.True s1 s2 = s1 :: s2 :: Nil

  ray-three-third : B.Bool -> Player -> a -> a -> Cell -> List a
  ray-three-third B.False p s1 s2 c3 = Nil
  ray-three-third B.True p s1 s2 c3 = ray-three-end (is-disc p c3) s1 s2

  ray-three-second : B.Bool -> Player -> a -> a -> Cell -> Cell -> List a
  ray-three-second B.True p s1 s2 c2 c3 = s1 :: Nil
  ray-three-second B.False p s1 s2 c2 c3 = ray-three-third (is-disc (C.other p) c2) p s1 s2 c3

  ray-three-first : B.Bool -> Player -> a -> a -> Cell -> Cell -> List a
  ray-three-first B.False p s1 s2 c2 c3 = Nil
  ray-three-first B.True p s1 s2 c2 c3 = ray-three-second (is-disc p c2) p s1 s2 c2 c3

ray-two : Player -> a -> Cell -> Cell -> List a
ray-two p s1 c1 c2 = ray-two-step (is-disc (C.other p) c1) p s1 c2

ray-three : Player -> a -> a -> Cell -> Cell -> Cell -> List a
ray-three p s1 s2 c1 c2 c3 = ray-three-first (is-disc (C.other p) c1) p s1 s2 c2 c3

private
  map-ray-two-end : (f : a -> b) -> (ok : B.Bool) -> (s1 : a) -> L.map f (ray-two-end ok s1) = ray-two-end ok (f s1)
  map-ray-two-end f B.False s1 = rfl
  map-ray-two-end f B.True s1 = rfl

  map-ray-two-step : (f : a -> b) -> (ok : B.Bool) -> (p : Player) -> (s1 : a) -> (c2 : Cell) -> L.map f (ray-two-step ok p s1 c2) = ray-two-step ok p (f s1) c2
  map-ray-two-step f B.False p s1 c2 = rfl
  map-ray-two-step f B.True p s1 c2 = map-ray-two-end f (is-disc p c2) s1

  map-ray-three-end : (f : a -> b) -> (ok : B.Bool) -> (s1 s2 : a) -> L.map f (ray-three-end ok s1 s2) = ray-three-end ok (f s1) (f s2)
  map-ray-three-end f B.False s1 s2 = rfl
  map-ray-three-end f B.True s1 s2 = rfl

  map-ray-three-third : (f : a -> b) -> (ok : B.Bool) -> (p : Player) -> (s1 s2 : a) -> (c3 : Cell) -> L.map f (ray-three-third ok p s1 s2 c3) = ray-three-third ok p (f s1) (f s2) c3
  map-ray-three-third f B.False p s1 s2 c3 = rfl
  map-ray-three-third f B.True p s1 s2 c3 = map-ray-three-end f (is-disc p c3) s1 s2

  map-ray-three-second : (f : a -> b) -> (ok : B.Bool) -> (p : Player) -> (s1 s2 : a) -> (c2 c3 : Cell) -> L.map f (ray-three-second ok p s1 s2 c2 c3) = ray-three-second ok p (f s1) (f s2) c2 c3
  map-ray-three-second f B.True p s1 s2 c2 c3 = rfl
  map-ray-three-second f B.False p s1 s2 c2 c3 = map-ray-three-third f (is-disc (C.other p) c2) p s1 s2 c3

  map-ray-three-first : (f : a -> b) -> (ok : B.Bool) -> (p : Player) -> (s1 s2 : a) -> (c2 c3 : Cell) -> L.map f (ray-three-first ok p s1 s2 c2 c3) = ray-three-first ok p (f s1) (f s2) c2 c3
  map-ray-three-first f B.False p s1 s2 c2 c3 = rfl
  map-ray-three-first f B.True p s1 s2 c2 c3 = map-ray-three-second f (is-disc p c2) p s1 s2 c2 c3

map-ray-two : (f : a -> b) -> (p : Player) -> (s1 : a) -> (c1 c2 : Cell) -> L.map f (ray-two p s1 c1 c2) = ray-two p (f s1) c1 c2
map-ray-two f p s1 c1 c2 = map-ray-two-step f (is-disc (C.other p) c1) p s1 c2

map-ray-three : (f : a -> b) -> (p : Player) -> (s1 s2 : a) -> (c1 c2 c3 : Cell) -> L.map f (ray-three p s1 s2 c1 c2 c3) = ray-three p (f s1) (f s2) c1 c2 c3
map-ray-three f p s1 s2 c1 c2 c3 = map-ray-three-first f (is-disc (C.other p) c1) p s1 s2 c2 c3

private
  scan-one-disc : (p q : Player) -> (s1 : Square) -> captured (scan-cell p s1 (C.Disc q) Unbracketed) = Nil
  scan-one-disc C.Black C.Black s1 = rfl
  scan-one-disc C.Black C.White s1 = rfl
  scan-one-disc C.White C.Black s1 = rfl
  scan-one-disc C.White C.White s1 = rfl

  scan-one-nil : (p : Player) -> (s1 : Square) -> (c1 : Cell) -> captured (scan-cell p s1 c1 Unbracketed) = Nil
  scan-one-nil p s1 C.Empty = rfl
  scan-one-nil p s1 (C.Disc q) = scan-one-disc p q s1

  scan-two-dd : (p q1 q2 : Player) -> (s1 s2 : Square) -> captured (scan-cell p s1 (C.Disc q1) (scan-cell p s2 (C.Disc q2) Unbracketed)) = ray-two p s1 (C.Disc q1) (C.Disc q2)
  scan-two-dd C.Black C.Black C.Black s1 s2 = rfl
  scan-two-dd C.Black C.Black C.White s1 s2 = rfl
  scan-two-dd C.Black C.White C.Black s1 s2 = rfl
  scan-two-dd C.Black C.White C.White s1 s2 = rfl
  scan-two-dd C.White C.Black C.Black s1 s2 = rfl
  scan-two-dd C.White C.Black C.White s1 s2 = rfl
  scan-two-dd C.White C.White C.Black s1 s2 = rfl
  scan-two-dd C.White C.White C.White s1 s2 = rfl

  scan-two-de : (p q1 : Player) -> (s1 s2 : Square) -> captured (scan-cell p s1 (C.Disc q1) Unbracketed) = ray-two p s1 (C.Disc q1) C.Empty
  scan-two-de C.Black C.Black s1 s2 = rfl
  scan-two-de C.Black C.White s1 s2 = rfl
  scan-two-de C.White C.Black s1 s2 = rfl
  scan-two-de C.White C.White s1 s2 = rfl

  scan-two-d : (p q1 : Player) -> (s1 s2 : Square) -> (c2 : Cell) -> captured (scan-cell p s1 (C.Disc q1) (scan-cell p s2 c2 Unbracketed)) = ray-two p s1 (C.Disc q1) c2
  scan-two-d p q1 s1 s2 C.Empty = scan-two-de p q1 s1 s2
  scan-two-d p q1 s1 s2 (C.Disc q2) = scan-two-dd p q1 q2 s1 s2

  scan-two-eq : (p : Player) -> (s1 s2 : Square) -> (c1 c2 : Cell) -> captured (scan-cell p s1 c1 (scan-cell p s2 c2 Unbracketed)) = ray-two p s1 c1 c2
  scan-two-eq p s1 s2 C.Empty c2 = rfl
  scan-two-eq p s1 s2 (C.Disc q1) c2 = scan-two-d p q1 s1 s2 c2

  scan-three-ddd : (p q1 q2 q3 : Player) -> (s1 s2 s3 : Square) -> captured (scan-cell p s1 (C.Disc q1) (scan-cell p s2 (C.Disc q2) (scan-cell p s3 (C.Disc q3) Unbracketed))) = ray-three p s1 s2 (C.Disc q1) (C.Disc q2) (C.Disc q3)
  scan-three-ddd C.Black C.Black C.Black C.Black s1 s2 s3 = rfl
  scan-three-ddd C.Black C.Black C.Black C.White s1 s2 s3 = rfl
  scan-three-ddd C.Black C.Black C.White C.Black s1 s2 s3 = rfl
  scan-three-ddd C.Black C.Black C.White C.White s1 s2 s3 = rfl
  scan-three-ddd C.Black C.White C.Black C.Black s1 s2 s3 = rfl
  scan-three-ddd C.Black C.White C.Black C.White s1 s2 s3 = rfl
  scan-three-ddd C.Black C.White C.White C.Black s1 s2 s3 = rfl
  scan-three-ddd C.Black C.White C.White C.White s1 s2 s3 = rfl
  scan-three-ddd C.White C.Black C.Black C.Black s1 s2 s3 = rfl
  scan-three-ddd C.White C.Black C.Black C.White s1 s2 s3 = rfl
  scan-three-ddd C.White C.Black C.White C.Black s1 s2 s3 = rfl
  scan-three-ddd C.White C.Black C.White C.White s1 s2 s3 = rfl
  scan-three-ddd C.White C.White C.Black C.Black s1 s2 s3 = rfl
  scan-three-ddd C.White C.White C.Black C.White s1 s2 s3 = rfl
  scan-three-ddd C.White C.White C.White C.Black s1 s2 s3 = rfl
  scan-three-ddd C.White C.White C.White C.White s1 s2 s3 = rfl

  scan-three-dde : (p q1 q2 : Player) -> (s1 s2 s3 : Square) -> captured (scan-cell p s1 (C.Disc q1) (scan-cell p s2 (C.Disc q2) Unbracketed)) = ray-three p s1 s2 (C.Disc q1) (C.Disc q2) C.Empty
  scan-three-dde C.Black C.Black C.Black s1 s2 s3 = rfl
  scan-three-dde C.Black C.Black C.White s1 s2 s3 = rfl
  scan-three-dde C.Black C.White C.Black s1 s2 s3 = rfl
  scan-three-dde C.Black C.White C.White s1 s2 s3 = rfl
  scan-three-dde C.White C.Black C.Black s1 s2 s3 = rfl
  scan-three-dde C.White C.Black C.White s1 s2 s3 = rfl
  scan-three-dde C.White C.White C.Black s1 s2 s3 = rfl
  scan-three-dde C.White C.White C.White s1 s2 s3 = rfl

  scan-three-de : (p q1 : Player) -> (s1 s2 s3 : Square) -> (c3 : Cell) -> captured (scan-cell p s1 (C.Disc q1) Unbracketed) = ray-three p s1 s2 (C.Disc q1) C.Empty c3
  scan-three-de C.Black C.Black s1 s2 s3 c3 = rfl
  scan-three-de C.Black C.White s1 s2 s3 c3 = rfl
  scan-three-de C.White C.Black s1 s2 s3 c3 = rfl
  scan-three-de C.White C.White s1 s2 s3 c3 = rfl

  scan-three-dd : (p q1 q2 : Player) -> (s1 s2 s3 : Square) -> (c3 : Cell) -> captured (scan-cell p s1 (C.Disc q1) (scan-cell p s2 (C.Disc q2) (scan-cell p s3 c3 Unbracketed))) = ray-three p s1 s2 (C.Disc q1) (C.Disc q2) c3
  scan-three-dd p q1 q2 s1 s2 s3 C.Empty = scan-three-dde p q1 q2 s1 s2 s3
  scan-three-dd p q1 q2 s1 s2 s3 (C.Disc q3) = scan-three-ddd p q1 q2 q3 s1 s2 s3

  scan-three-d : (p q1 : Player) -> (s1 s2 s3 : Square) -> (c2 c3 : Cell) -> captured (scan-cell p s1 (C.Disc q1) (scan-cell p s2 c2 (scan-cell p s3 c3 Unbracketed))) = ray-three p s1 s2 (C.Disc q1) c2 c3
  scan-three-d p q1 s1 s2 s3 C.Empty c3 = scan-three-de p q1 s1 s2 s3 c3
  scan-three-d p q1 s1 s2 s3 (C.Disc q2) c3 = scan-three-dd p q1 q2 s1 s2 s3 c3

  scan-three-eq : (p : Player) -> (s1 s2 s3 : Square) -> (c1 c2 c3 : Cell) -> captured (scan-cell p s1 c1 (scan-cell p s2 c2 (scan-cell p s3 c3 Unbracketed))) = ray-three p s1 s2 c1 c2 c3
  scan-three-eq p s1 s2 s3 C.Empty c2 c3 = rfl
  scan-three-eq p s1 s2 s3 (C.Disc q1) c2 c3 = scan-three-d p q1 s1 s2 s3 c2 c3

captures-on-nil : (p : Player) -> (b : Board) -> (s : Square) -> (d : Direction) -> ray (C.size b) d s = Nil -> captures-on p b s d = Nil
captures-on-nil p b s d h = calc
  captures-on p b s d
  = captured (scan p b (ray (C.size b) d s))
  = captured (scan p b Nil) := cong h
  = Nil

captures-on-one : (p : Player) -> (b : Board) -> (s : Square) -> (d : Direction) -> (s1 : Square) -> (c1 : Cell) -> ray (C.size b) d s = s1 :: Nil -> C.read s1 b = M.Just c1 -> captures-on p b s d = Nil
captures-on-one p b s d s1 c1 hr h1 = calc
  captures-on p b s d
  = captured (scan p b (ray (C.size b) d s))
  = captured (scan p b (s1 :: Nil)) := cong hr
  = captured (scan-read p s1 (C.read s1 b) Unbracketed)
  = captured (scan-read p s1 (M.Just c1) Unbracketed) := cong h1
  = captured (scan-cell p s1 c1 Unbracketed)
  = Nil := scan-one-nil p s1 c1

captures-on-two : (p : Player) -> (b : Board) -> (s : Square) -> (d : Direction) -> (s1 s2 : Square) -> (c1 c2 : Cell) -> ray (C.size b) d s = s1 :: s2 :: Nil -> C.read s1 b = M.Just c1 -> C.read s2 b = M.Just c2 -> captures-on p b s d = ray-two p s1 c1 c2
captures-on-two p b s d s1 s2 c1 c2 hr h1 h2 = calc
  captures-on p b s d
  = captured (scan p b (ray (C.size b) d s))
  = captured (scan p b (s1 :: s2 :: Nil)) := cong hr
  = captured (scan-read p s1 (C.read s1 b) (scan-read p s2 (C.read s2 b) Unbracketed))
  = captured (scan-read p s1 (M.Just c1) (scan-read p s2 (C.read s2 b) Unbracketed)) := cong h1
  = captured (scan-cell p s1 c1 (scan-read p s2 (C.read s2 b) Unbracketed))
  = captured (scan-cell p s1 c1 (scan-read p s2 (M.Just c2) Unbracketed)) := cong h2
  = captured (scan-cell p s1 c1 (scan-cell p s2 c2 Unbracketed))
  = ray-two p s1 c1 c2 := scan-two-eq p s1 s2 c1 c2

captures-on-three : (p : Player) -> (b : Board) -> (s : Square) -> (d : Direction) -> (s1 s2 s3 : Square) -> (c1 c2 c3 : Cell) -> ray (C.size b) d s = s1 :: s2 :: s3 :: Nil -> C.read s1 b = M.Just c1 -> C.read s2 b = M.Just c2 -> C.read s3 b = M.Just c3 -> captures-on p b s d = ray-three p s1 s2 c1 c2 c3
captures-on-three p b s d s1 s2 s3 c1 c2 c3 hr h1 h2 h3 = calc
  captures-on p b s d
  = captured (scan p b (ray (C.size b) d s))
  = captured (scan p b (s1 :: s2 :: s3 :: Nil)) := cong hr
  = captured (scan-read p s1 (C.read s1 b) (scan-read p s2 (C.read s2 b) (scan-read p s3 (C.read s3 b) Unbracketed)))
  = captured (scan-read p s1 (M.Just c1) (scan-read p s2 (C.read s2 b) (scan-read p s3 (C.read s3 b) Unbracketed))) := cong h1
  = captured (scan-cell p s1 c1 (scan-read p s2 (C.read s2 b) (scan-read p s3 (C.read s3 b) Unbracketed)))
  = captured (scan-cell p s1 c1 (scan-read p s2 (M.Just c2) (scan-read p s3 (C.read s3 b) Unbracketed))) := cong h2
  = captured (scan-cell p s1 c1 (scan-cell p s2 c2 (scan-read p s3 (C.read s3 b) Unbracketed)))
  = captured (scan-cell p s1 c1 (scan-cell p s2 c2 (scan-read p s3 (M.Just c3) Unbracketed))) := cong h3
  = captured (scan-cell p s1 c1 (scan-cell p s2 c2 (scan-cell p s3 c3 Unbracketed)))
  = ray-three p s1 s2 c1 c2 c3 := scan-three-eq p s1 s2 s3 c1 c2 c3

captures : Player -> Board -> Square -> List (Square)
captures p b s = L.concat (L.map (\d -> captures-on p b s d) directions)

nonempty : List a -> B.Bool
nonempty Nil = B.False
nonempty (x :: xs) = B.True

legal-placement : Player -> Board -> Square -> B.Bool
legal-placement p b s = B.and (C.well-formed b) (B.and (C.empty-cell (C.read s b)) (nonempty (captures p b s)))

placements : Player -> Board -> List (Square)
placements p b = L.concat (L.map (\s -> B.choose (legal-placement p b s) (L.singleton s) Nil) (C.squares (C.size b)))

has-placement : Player -> Board -> B.Bool
has-placement p b = nonempty (placements p b)

terminal : Board -> B.Bool
terminal b = B.and (C.well-formed b) (B.not (B.or (has-placement C.Black b) (has-placement C.White b)))

pass-allowed : Player -> Board -> B.Bool
pass-allowed p b = B.and (B.not (has-placement p b)) (has-placement (C.other p) b)

paint : Player -> List (Square) -> Board -> Board
paint p Nil b = b
paint p (s :: ss) b = C.write s (C.Disc p) (paint p ss b)

paint-size : (p : Player) -> (ss : List Square) -> (b : Board) -> C.size (paint p ss b) = C.size b
paint-size p Nil b = rfl
paint-size p (s :: ss) b = calc
  C.size (paint p (s :: ss) b)
  = C.size (C.write s (C.Disc p) (paint p ss b))
  = C.size (paint p ss b) := C.write-size s (C.Disc p) (paint p ss b)
  = C.size b := paint-size p ss b

paint-length : (p : Player) -> (ss : List Square) -> (b : Board) -> L.length (C.cells (paint p ss b)) = L.length (C.cells b)
paint-length p Nil b = rfl
paint-length p (s :: ss) b = calc
  L.length (C.cells (paint p (s :: ss) b))
  = L.length (C.cells (C.write s (C.Disc p) (paint p ss b)))
  = L.length (C.cells (paint p ss b)) := C.write-length s (C.Disc p) (paint p ss b)
  = L.length (C.cells b) := paint-length p ss b

-- Every capture is determined on the original board, before any discs
-- are flipped. This prevents a flip in one direction enabling another.
place : Player -> Board -> Square -> Board
place p b s = C.write s (C.Disc p) (paint p (captures p b s) b)

place-size : (p : Player) -> (b : Board) -> (s : Square) -> C.size (place p b s) = C.size b
place-size p b s = calc
  C.size (place p b s)
  = C.size (paint p (captures p b s) b) := C.write-size s (C.Disc p) (paint p (captures p b s) b)
  = C.size b := paint-size p (captures p b s) b

place-length : (p : Player) -> (b : Board) -> (s : Square) -> L.length (C.cells (place p b s)) = L.length (C.cells b)
place-length p b s = calc
  L.length (C.cells (place p b s))
  = L.length (C.cells (paint p (captures p b s) b)) := C.write-length s (C.Disc p) (paint p (captures p b s) b)
  = L.length (C.cells b) := paint-length p (captures p b s) b

data Move where
  Place : Square -> Move
  Pass : Move
open Move public

legal : Player -> Board -> Move -> B.Bool
legal p b (Place s) = legal-placement p b s
legal p b Pass = pass-allowed p b

-- A rejected move has no successor. Passing is disallowed when a
-- placement exists, and also when neither player can move (game over).
play : Player -> Board -> Move -> M.Maybe (Board)
play p b (Place s) = B.choose (legal-placement p b s) (M.Just (place p b s)) M.Nothing
play p b Pass = B.choose (pass-allowed p b) (M.Just b) M.Nothing

moves : Player -> Board -> List (Move)
moves p b = L.map (\s -> Place s) (placements p b) <> B.choose (pass-allowed p b) (L.singleton Pass) Nil

data Position where
  Turn : Player -> Board -> Position
open Position public

to-move : Position -> Player
to-move (Turn p b) = p

board : Position -> Board
board (Turn p b) = b

successor : Position -> Move -> M.Maybe (Position)
successor (Turn p b) m = M.map (\next -> Turn (C.other p) next) (play p b m)

data Outcome = BlackWins | Draw | WhiteWins
open Outcome public

-- Scores count discs actually present on the terminal board. Empty
-- squares are not silently credited to either player.
outcome : Board -> Outcome
outcome b = B.choose (B.less-nat (C.count C.Black b) (C.count C.White b)) WhiteWins (B.choose (B.less-nat (C.count C.White b) (C.count C.Black b)) BlackWins Draw)

result : Board -> M.Maybe Outcome
result b = B.choose (terminal b) (M.Just (outcome b)) M.Nothing
