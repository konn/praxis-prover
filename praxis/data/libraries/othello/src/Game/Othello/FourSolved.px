module Game.Othello.FourSolved where

import "base" Data.Bool as B
import "base" Data.List as L
import "base" Data.Maybe as M
import Game.Othello.Board as C
import Game.Othello.Rules as R
import Game.Othello.Initial as I
import Game.Othello.Certificate as K
import Game.Othello.Four as F
open L using (List, Nil, (::))

-- Pure Praxis 4x4 winning strategy for White, with no external generator.
-- At White turns, pick the first legal square in a zero-lookahead static
-- priority order: `order-top` for the (0,1)/(1,0) openings (claiming (0,0) on
-- ply 1) and its 180-degree rotation `order-bot` for the (3,2)/(2,3) openings
-- (claiming (3,3) on ply 1). Once claimed, that corner stays White for the
-- entire game, selecting the matching order statelessly.
private
  order-top : List F.Sq4
  order-top = F.At4 F.I0 F.I0 :: F.At4 F.I2 F.I0 :: F.At4 F.I0 F.I2 :: F.At4 F.I3 F.I0 :: F.At4 F.I3 F.I3 :: F.At4 F.I1 F.I3 :: F.At4 F.I0 F.I3 :: F.At4 F.I2 F.I3 :: F.At4 F.I3 F.I2 :: F.At4 F.I3 F.I1 :: F.At4 F.I1 F.I0 :: F.At4 F.I0 F.I1 :: Nil

  order-bot : List F.Sq4
  order-bot = F.At4 F.I3 F.I3 :: F.At4 F.I1 F.I3 :: F.At4 F.I3 F.I1 :: F.At4 F.I0 F.I3 :: F.At4 F.I0 F.I0 :: F.At4 F.I2 F.I0 :: F.At4 F.I3 F.I0 :: F.At4 F.I1 F.I0 :: F.At4 F.I0 F.I1 :: F.At4 F.I0 F.I2 :: F.At4 F.I2 F.I3 :: F.At4 F.I3 F.I2 :: Nil

  order-open : List F.Sq4
  order-open = F.At4 F.I0 F.I0 :: F.At4 F.I3 F.I3 :: Nil

  white-order-bot-player : C.Player -> List F.Sq4
  white-order-bot-player C.Black = order-open
  white-order-bot-player C.White = order-bot

  white-order-bot : C.Cell -> List F.Sq4
  white-order-bot C.Empty = order-open
  white-order-bot (C.Disc p) = white-order-bot-player p

  white-order-top-player : F.Board4 -> C.Player -> List F.Sq4
  white-order-top-player b C.Black = white-order-bot (F.read4 (F.At4 F.I3 F.I3) b)
  white-order-top-player b C.White = order-top

  white-order-top : F.Board4 -> C.Cell -> List F.Sq4
  white-order-top b C.Empty = white-order-bot (F.read4 (F.At4 F.I3 F.I3) b)
  white-order-top b (C.Disc p) = white-order-top-player b p

  white-order : F.Board4 -> List F.Sq4
  white-order b = white-order-top b (F.read4 (F.At4 F.I0 F.I0) b)

  first-legal-in : F.Board4 -> List F.Sq4 -> M.Maybe F.Sq4
  first-legal-in b Nil = M.Nothing
  first-legal-in b (s :: ss) = B.choose (F.legal-placement4 C.White b s) (M.Just s) (first-legal-in b ss)

  white-place : F.Board4 -> M.Maybe F.Sq4
  white-place b = first-legal-in b (white-order b)

  next-white : F.Board4 -> M.Maybe F.Sq4 -> F.Board4
  next-white b M.Nothing = b
  next-white b (M.Just s) = F.next-board4 b (F.play4 C.White b (F.Place4 s))

  -- Pure boolean combinators indexed directly into Check4.
  wins-black : B.Bool -> B.Bool -> B.Bool -> B.Bool
  wins-black B.True score ok = score
  wins-black B.False score ok = ok

  wins-maybe : M.Maybe F.Board4 -> B.Bool -> B.Bool
  wins-maybe M.Nothing ok = B.False
  wins-maybe (M.Just nb) ok = ok

  wins-white-pick : F.Board4 -> M.Maybe F.Sq4 -> B.Bool -> B.Bool
  wins-white-pick b M.Nothing ok = B.and (F.terminal4 b) (F.le-nat 9 (F.white-score4 b))
  wins-white-pick b (M.Just s) ok = wins-maybe (F.play4 C.White b (F.Place4 s)) ok

  -- Certified Check4 step combinators carrying their boolean result as an index.
  wrap-leaf-score : {p : C.Player} -> {b : F.Board4} -> {s : B.Bool} -> F.terminal4 b = B.True -> F.le-nat 9 (F.white-score4 b) = s -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 p b)) 9) s
  wrap-leaf-score {p} {b} {B.False} ht hs = F.Invalid4 {K.AtBound K.Lower (F.to-pos4 (F.Turn4 p b)) 9}
  wrap-leaf-score {p} {b} {B.True} ht hs = F.Valid4 {K.AtBound K.Lower (F.to-pos4 (F.Turn4 p b)) 9} (F.mk-leaf {p} {b} {9} ht hs)

  wrap-leaf : {p : C.Player} -> {b : F.Board4} -> {t : B.Bool} -> F.terminal4 b = t -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 p b)) 9) (B.and t (F.le-nat 9 (F.white-score4 b)))
  wrap-leaf {p} {b} {B.False} ht = F.Invalid4 {K.AtBound K.Lower (F.to-pos4 (F.Turn4 p b)) 9}
  wrap-leaf {p} {b} {B.True} ht = wrap-leaf-score {p} {b} {F.le-nat 9 (F.white-score4 b)} ht rfl

  step-leaf : {p : C.Player} -> {b : F.Board4} -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 p b)) 9) (B.and (F.terminal4 b) (F.le-nat 9 (F.white-score4 b)))
  step-leaf {p} {b} = wrap-leaf {p} {b} {F.terminal4 b} rfl

  wrap-black-cs : {b : F.Board4} -> {ok : B.Bool} -> F.terminal4 b = B.False -> F.Check4 (K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 (F.moves4 C.Black b))) ok -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9) ok
  wrap-black-cs {b} ht F.Invalid4 = F.Invalid4 {K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9}
  wrap-black-cs {b} ht (F.Valid4 d) = F.Valid4 {K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9} (F.mk-replies {b} {9} ht d)

  wrap-black : {b : F.Board4} -> {t ok : B.Bool} -> F.terminal4 b = t -> F.Check4 (K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 (F.moves4 C.Black b))) ok -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9) (wins-black t (F.le-nat 9 (F.white-score4 b)) ok)
  wrap-black {b} {B.True} {ok} ht cs = wrap-leaf-score {C.Black} {b} {F.le-nat 9 (F.white-score4 b)} ht rfl
  wrap-black {b} {B.False} {ok} ht cs = wrap-black-cs {b} {ok} ht cs

  step-black : {b : F.Board4} -> {ok : B.Bool} -> F.Check4 (K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 (F.moves4 C.Black b))) ok -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9) (wins-black (F.terminal4 b) (F.le-nat 9 (F.white-score4 b)) ok)
  step-black {b} {ok} cs = wrap-black {b} {F.terminal4 b} {ok} rfl cs

  wrap-white-cc : {b : F.Board4} -> {m : F.Move4} -> {nb : F.Board4} -> {ok : B.Bool} -> F.play4 C.White b m = M.Just nb -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black (F.next-board4 b (F.play4 C.White b m)))) 9) ok -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.White b)) 9) ok
  wrap-white-cc {b} {m} {nb} hp F.Invalid4 = F.Invalid4 {K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.White b)) 9}
  wrap-white-cc {b} {m} {nb} hp (F.Valid4 d) = F.Valid4 {K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.White b)) 9} (F.mk-choice {b} {9} {m} {nb} hp d)

  wrap-white-succ : {b : F.Board4} -> {m : F.Move4} -> {mb : M.Maybe F.Board4} -> {ok : B.Bool} -> F.play4 C.White b m = mb -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black (F.next-board4 b (F.play4 C.White b m)))) 9) ok -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.White b)) 9) (wins-maybe mb ok)
  wrap-white-succ {b} {m} {M.Nothing} {ok} hp cc = F.Invalid4 {K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.White b)) 9}
  wrap-white-succ {b} {m} {M.Just nb} {ok} hp cc = wrap-white-cc {b} {m} {nb} {ok} hp cc

  wrap-white : {b : F.Board4} -> {ms : M.Maybe F.Sq4} -> {ok : B.Bool} -> white-place b = ms -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black (next-white b ms))) 9) ok -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.White b)) 9) (wins-white-pick b ms ok)
  wrap-white {b} {M.Nothing} {ok} hm cc = step-leaf {C.White} {b}
  wrap-white {b} {M.Just s} {ok} hm cc = wrap-white-succ {b} {F.Place4 s} {F.play4 C.White b (F.Place4 s)} {ok} rfl cc

  step-white : {b : F.Board4} -> {ok : B.Bool} -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black (next-white b (white-place b)))) 9) ok -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.White b)) 9) (wins-white-pick b (white-place b) ok)
  step-white {b} {ok} cc = wrap-white {b} {white-place b} {ok} rfl cc

  wrap-reply-2 : {b : F.Board4} -> {m : F.Move4} -> {ms : List F.Move4} -> {nb : F.Board4} -> {ok2 : B.Bool} -> F.play4 C.Black b m = M.Just nb -> K.Derivation (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.White (F.next-board4 b (F.play4 C.Black b m)))) 9) -> F.Check4 (K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 ms)) ok2 -> F.Check4 (K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 (m :: ms))) ok2
  wrap-reply-2 {b} {m} {ms} {nb} hp dc F.Invalid4 = F.Invalid4 {K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 (m :: ms))}
  wrap-reply-2 {b} {m} {ms} {nb} hp dc (F.Valid4 ds) = F.Valid4 {K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 (m :: ms))} (F.mk-reply {b} {9} {m} {ms} {nb} hp dc ds)

  wrap-reply-1 : {b : F.Board4} -> {m : F.Move4} -> {ms : List F.Move4} -> {nb : F.Board4} -> {ok2 ok1 : B.Bool} -> F.play4 C.Black b m = M.Just nb -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.White (F.next-board4 b (F.play4 C.Black b m)))) 9) ok1 -> F.Check4 (K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 ms)) ok2 -> F.Check4 (K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 (m :: ms))) (B.and ok1 ok2)
  wrap-reply-1 {b} {m} {ms} {nb} {ok2} hp F.Invalid4 cs = F.Invalid4 {K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 (m :: ms))}
  wrap-reply-1 {b} {m} {ms} {nb} {ok2} hp (F.Valid4 dc) cs = wrap-reply-2 {b} {m} {ms} {nb} {ok2} hp dc cs

  wrap-reply-succ : {b : F.Board4} -> {m : F.Move4} -> {ms : List F.Move4} -> {mb : M.Maybe F.Board4} -> {ok1 ok2 : B.Bool} -> F.play4 C.Black b m = mb -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.White (F.next-board4 b (F.play4 C.Black b m)))) 9) ok1 -> F.Check4 (K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 ms)) ok2 -> F.Check4 (K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 (m :: ms))) (wins-maybe mb (B.and ok1 ok2))
  wrap-reply-succ {b} {m} {ms} {M.Nothing} {ok1} {ok2} hp cc cs = F.Invalid4 {K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 (m :: ms))}
  wrap-reply-succ {b} {m} {ms} {M.Just nb} {ok1} {ok2} hp cc cs = wrap-reply-1 {b} {m} {ms} {nb} {ok2} {ok1} hp cc cs

  step-reply : {b : F.Board4} -> {m : F.Move4} -> {ms : List F.Move4} -> {ok1 ok2 : B.Bool} -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.White (F.next-board4 b (F.play4 C.Black b m)))) 9) ok1 -> F.Check4 (K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 ms)) ok2 -> F.Check4 (K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 (m :: ms))) (wins-maybe (F.play4 C.Black b m) (B.and ok1 ok2))
  step-reply {b} {m} {ms} {ok1} {ok2} cc cs = wrap-reply-succ {b} {m} {ms} {F.play4 C.Black b m} {ok1} {ok2} rfl cc cs

  -- Seven Black-White rounds from the 4x4 opening (max depth 14 plies).
  -- `wins-black-7` runs purely on Board4 booleans for `by decide`;
  -- `black-7` carries `wins-black-7` as its index and builds the
  -- certified K.Derivation in a single top-down pass.
  wins-black-0 : F.Board4 -> B.Bool
  wins-black-0 b = B.and (F.terminal4 b) (F.le-nat 9 (F.white-score4 b))

  black-0 : {b : F.Board4} -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9) (wins-black-0 b)
  black-0 {b} = step-leaf {C.Black} {b}

  -- Round 1 (plies 12-13)
  wins-white-1 : F.Board4 -> B.Bool
  wins-white-1 b = wins-white-pick b (white-place b) (wins-black-0 (next-white b (white-place b)))

  white-1 : {b : F.Board4} -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.White b)) 9) (wins-white-1 b)
  white-1 {b} = step-white {b} {wins-black-0 (next-white b (white-place b))} (black-0 {next-white b (white-place b)})

  wins-replies-1 : F.Board4 -> List F.Move4 -> B.Bool
  wins-replies-1 b Nil = B.True
  wins-replies-1 b (m :: ms) = wins-maybe (F.play4 C.Black b m) (B.and (wins-white-1 (F.next-board4 b (F.play4 C.Black b m))) (wins-replies-1 b ms))

  replies-1 : {b : F.Board4} -> {ms : List F.Move4} -> F.Check4 (K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 ms)) (wins-replies-1 b ms)
  replies-1 {b} {Nil} = F.Valid4 {K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 Nil} (F.mk-no-moves {F.Turn4 C.Black b} {9})
  replies-1 {b} {m :: ms} = step-reply {b} {m} {ms} {wins-white-1 (F.next-board4 b (F.play4 C.Black b m))} {wins-replies-1 b ms} (white-1 {F.next-board4 b (F.play4 C.Black b m)}) (replies-1 {b} {ms})

  wins-black-1 : F.Board4 -> B.Bool
  wins-black-1 b = wins-black (F.terminal4 b) (F.le-nat 9 (F.white-score4 b)) (wins-replies-1 b (F.moves4 C.Black b))

  black-1 : {b : F.Board4} -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9) (wins-black-1 b)
  black-1 {b} = step-black {b} {wins-replies-1 b (F.moves4 C.Black b)} (replies-1 {b} {F.moves4 C.Black b})

  -- Round 2 (plies 10-11)
  wins-white-2 : F.Board4 -> B.Bool
  wins-white-2 b = wins-white-pick b (white-place b) (wins-black-1 (next-white b (white-place b)))

  white-2 : {b : F.Board4} -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.White b)) 9) (wins-white-2 b)
  white-2 {b} = step-white {b} {wins-black-1 (next-white b (white-place b))} (black-1 {next-white b (white-place b)})

  wins-replies-2 : F.Board4 -> List F.Move4 -> B.Bool
  wins-replies-2 b Nil = B.True
  wins-replies-2 b (m :: ms) = wins-maybe (F.play4 C.Black b m) (B.and (wins-white-2 (F.next-board4 b (F.play4 C.Black b m))) (wins-replies-2 b ms))

  replies-2 : {b : F.Board4} -> {ms : List F.Move4} -> F.Check4 (K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 ms)) (wins-replies-2 b ms)
  replies-2 {b} {Nil} = F.Valid4 {K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 Nil} (F.mk-no-moves {F.Turn4 C.Black b} {9})
  replies-2 {b} {m :: ms} = step-reply {b} {m} {ms} {wins-white-2 (F.next-board4 b (F.play4 C.Black b m))} {wins-replies-2 b ms} (white-2 {F.next-board4 b (F.play4 C.Black b m)}) (replies-2 {b} {ms})

  wins-black-2 : F.Board4 -> B.Bool
  wins-black-2 b = wins-black (F.terminal4 b) (F.le-nat 9 (F.white-score4 b)) (wins-replies-2 b (F.moves4 C.Black b))

  black-2 : {b : F.Board4} -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9) (wins-black-2 b)
  black-2 {b} = step-black {b} {wins-replies-2 b (F.moves4 C.Black b)} (replies-2 {b} {F.moves4 C.Black b})

  -- Round 3 (plies 8-9)
  wins-white-3 : F.Board4 -> B.Bool
  wins-white-3 b = wins-white-pick b (white-place b) (wins-black-2 (next-white b (white-place b)))

  white-3 : {b : F.Board4} -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.White b)) 9) (wins-white-3 b)
  white-3 {b} = step-white {b} {wins-black-2 (next-white b (white-place b))} (black-2 {next-white b (white-place b)})

  wins-replies-3 : F.Board4 -> List F.Move4 -> B.Bool
  wins-replies-3 b Nil = B.True
  wins-replies-3 b (m :: ms) = wins-maybe (F.play4 C.Black b m) (B.and (wins-white-3 (F.next-board4 b (F.play4 C.Black b m))) (wins-replies-3 b ms))

  replies-3 : {b : F.Board4} -> {ms : List F.Move4} -> F.Check4 (K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 ms)) (wins-replies-3 b ms)
  replies-3 {b} {Nil} = F.Valid4 {K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 Nil} (F.mk-no-moves {F.Turn4 C.Black b} {9})
  replies-3 {b} {m :: ms} = step-reply {b} {m} {ms} {wins-white-3 (F.next-board4 b (F.play4 C.Black b m))} {wins-replies-3 b ms} (white-3 {F.next-board4 b (F.play4 C.Black b m)}) (replies-3 {b} {ms})

  wins-black-3 : F.Board4 -> B.Bool
  wins-black-3 b = wins-black (F.terminal4 b) (F.le-nat 9 (F.white-score4 b)) (wins-replies-3 b (F.moves4 C.Black b))

  black-3 : {b : F.Board4} -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9) (wins-black-3 b)
  black-3 {b} = step-black {b} {wins-replies-3 b (F.moves4 C.Black b)} (replies-3 {b} {F.moves4 C.Black b})

  -- Round 4 (plies 6-7)
  wins-white-4 : F.Board4 -> B.Bool
  wins-white-4 b = wins-white-pick b (white-place b) (wins-black-3 (next-white b (white-place b)))

  white-4 : {b : F.Board4} -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.White b)) 9) (wins-white-4 b)
  white-4 {b} = step-white {b} {wins-black-3 (next-white b (white-place b))} (black-3 {next-white b (white-place b)})

  wins-replies-4 : F.Board4 -> List F.Move4 -> B.Bool
  wins-replies-4 b Nil = B.True
  wins-replies-4 b (m :: ms) = wins-maybe (F.play4 C.Black b m) (B.and (wins-white-4 (F.next-board4 b (F.play4 C.Black b m))) (wins-replies-4 b ms))

  replies-4 : {b : F.Board4} -> {ms : List F.Move4} -> F.Check4 (K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 ms)) (wins-replies-4 b ms)
  replies-4 {b} {Nil} = F.Valid4 {K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 Nil} (F.mk-no-moves {F.Turn4 C.Black b} {9})
  replies-4 {b} {m :: ms} = step-reply {b} {m} {ms} {wins-white-4 (F.next-board4 b (F.play4 C.Black b m))} {wins-replies-4 b ms} (white-4 {F.next-board4 b (F.play4 C.Black b m)}) (replies-4 {b} {ms})

  wins-black-4 : F.Board4 -> B.Bool
  wins-black-4 b = wins-black (F.terminal4 b) (F.le-nat 9 (F.white-score4 b)) (wins-replies-4 b (F.moves4 C.Black b))

  black-4 : {b : F.Board4} -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9) (wins-black-4 b)
  black-4 {b} = step-black {b} {wins-replies-4 b (F.moves4 C.Black b)} (replies-4 {b} {F.moves4 C.Black b})

  -- Round 5 (plies 4-5)
  wins-white-5 : F.Board4 -> B.Bool
  wins-white-5 b = wins-white-pick b (white-place b) (wins-black-4 (next-white b (white-place b)))

  white-5 : {b : F.Board4} -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.White b)) 9) (wins-white-5 b)
  white-5 {b} = step-white {b} {wins-black-4 (next-white b (white-place b))} (black-4 {next-white b (white-place b)})

  wins-replies-5 : F.Board4 -> List F.Move4 -> B.Bool
  wins-replies-5 b Nil = B.True
  wins-replies-5 b (m :: ms) = wins-maybe (F.play4 C.Black b m) (B.and (wins-white-5 (F.next-board4 b (F.play4 C.Black b m))) (wins-replies-5 b ms))

  replies-5 : {b : F.Board4} -> {ms : List F.Move4} -> F.Check4 (K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 ms)) (wins-replies-5 b ms)
  replies-5 {b} {Nil} = F.Valid4 {K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 Nil} (F.mk-no-moves {F.Turn4 C.Black b} {9})
  replies-5 {b} {m :: ms} = step-reply {b} {m} {ms} {wins-white-5 (F.next-board4 b (F.play4 C.Black b m))} {wins-replies-5 b ms} (white-5 {F.next-board4 b (F.play4 C.Black b m)}) (replies-5 {b} {ms})

  wins-black-5 : F.Board4 -> B.Bool
  wins-black-5 b = wins-black (F.terminal4 b) (F.le-nat 9 (F.white-score4 b)) (wins-replies-5 b (F.moves4 C.Black b))

  black-5 : {b : F.Board4} -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9) (wins-black-5 b)
  black-5 {b} = step-black {b} {wins-replies-5 b (F.moves4 C.Black b)} (replies-5 {b} {F.moves4 C.Black b})

  -- Round 6 (plies 2-3)
  wins-white-6 : F.Board4 -> B.Bool
  wins-white-6 b = wins-white-pick b (white-place b) (wins-black-5 (next-white b (white-place b)))

  white-6 : {b : F.Board4} -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.White b)) 9) (wins-white-6 b)
  white-6 {b} = step-white {b} {wins-black-5 (next-white b (white-place b))} (black-5 {next-white b (white-place b)})

  wins-replies-6 : F.Board4 -> List F.Move4 -> B.Bool
  wins-replies-6 b Nil = B.True
  wins-replies-6 b (m :: ms) = wins-maybe (F.play4 C.Black b m) (B.and (wins-white-6 (F.next-board4 b (F.play4 C.Black b m))) (wins-replies-6 b ms))

  replies-6 : {b : F.Board4} -> {ms : List F.Move4} -> F.Check4 (K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 ms)) (wins-replies-6 b ms)
  replies-6 {b} {Nil} = F.Valid4 {K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 Nil} (F.mk-no-moves {F.Turn4 C.Black b} {9})
  replies-6 {b} {m :: ms} = step-reply {b} {m} {ms} {wins-white-6 (F.next-board4 b (F.play4 C.Black b m))} {wins-replies-6 b ms} (white-6 {F.next-board4 b (F.play4 C.Black b m)}) (replies-6 {b} {ms})

  wins-black-6 : F.Board4 -> B.Bool
  wins-black-6 b = wins-black (F.terminal4 b) (F.le-nat 9 (F.white-score4 b)) (wins-replies-6 b (F.moves4 C.Black b))

  black-6 : {b : F.Board4} -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9) (wins-black-6 b)
  black-6 {b} = step-black {b} {wins-replies-6 b (F.moves4 C.Black b)} (replies-6 {b} {F.moves4 C.Black b})

  -- Round 7 (plies 0-1, opening)
  wins-white-7 : F.Board4 -> B.Bool
  wins-white-7 b = wins-white-pick b (white-place b) (wins-black-6 (next-white b (white-place b)))

  white-7 : {b : F.Board4} -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.White b)) 9) (wins-white-7 b)
  white-7 {b} = step-white {b} {wins-black-6 (next-white b (white-place b))} (black-6 {next-white b (white-place b)})

  wins-replies-7 : F.Board4 -> List F.Move4 -> B.Bool
  wins-replies-7 b Nil = B.True
  wins-replies-7 b (m :: ms) = wins-maybe (F.play4 C.Black b m) (B.and (wins-white-7 (F.next-board4 b (F.play4 C.Black b m))) (wins-replies-7 b ms))

  replies-7 : {b : F.Board4} -> {ms : List F.Move4} -> F.Check4 (K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 (F.to-moves4 ms)) (wins-replies-7 b ms)
  replies-7 {b} {Nil} = F.Valid4 {K.AllMoves K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9 Nil} (F.mk-no-moves {F.Turn4 C.Black b} {9})
  replies-7 {b} {m :: ms} = step-reply {b} {m} {ms} {wins-white-7 (F.next-board4 b (F.play4 C.Black b m))} {wins-replies-7 b ms} (white-7 {F.next-board4 b (F.play4 C.Black b m)}) (replies-7 {b} {ms})

  wins-black-7 : F.Board4 -> B.Bool
  wins-black-7 b = wins-black (F.terminal4 b) (F.le-nat 9 (F.white-score4 b)) (wins-replies-7 b (F.moves4 C.Black b))

  black-7 : {b : F.Board4} -> F.Check4 (K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black b)) 9) (wins-black-7 b)
  black-7 {b} = step-black {b} {wins-replies-7 b (F.moves4 C.Black b)} (replies-7 {b} {F.moves4 C.Black b})

  four-wins : wins-black-7 F.initial4 = B.True
  four-wins = by decide

  opening-judgement : K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black F.initial4)) 9 = K.AtBound K.Lower I.four-opening 9
  opening-judgement = calc
    K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black F.initial4)) 9
    = K.AtBound K.Lower (F.to-pos4 F.opening4) 9
    = K.AtBound K.Lower I.four-opening 9 := cong F.opening4-eq

-- Problem 1: White can force a tournament score strictly above half.
white-wins : K.Derivation (K.AtBound K.Lower I.four-opening 9)
white-wins = K.cast {K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black F.initial4)) 9} {K.AtBound K.Lower I.four-opening 9} opening-judgement (F.extract4 {K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black F.initial4)) 9} (F.cast-check4 {K.AtBound K.Lower (F.to-pos4 (F.Turn4 C.Black F.initial4)) 9} {wins-black-7 F.initial4} {B.True} four-wins (black-7 {F.initial4})))
