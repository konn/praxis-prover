  captures4-r2-eq : (p : C.Player) -> (b : Board4) -> (c : I4) -> R.captures p (to-board b) (to-sq4 (At4 I2 c)) = to-sq4s (captures4-r2 p b c)
  captures4-r2-eq p b I0 = by
    have r0 : R.ray 4 R.North (to-sq4 (At4 I2 I0)) = to-sq4 (At4 I1 I0) :: to-sq4 (At4 I0 I0) :: Nil := by decide
