    have h : R.captures p (to-board b) (to-sq4 (At4 I2 I0)) = to-sq4s (r2 p b (At4 I1 I0) (At4 I0 I0) <> (r2 p b (At4 I1 I1) (At4 I0 I2) <> (r3 p b (At4 I2 I1) (At4 I2 I2) (At4 I2 I3) <> (no-sq4s <> (no-sq4s <> (no-sq4s <> (no-sq4s <> (no-sq4s <> no-sq4s)))))))) := combine8 p b (At4 I2 I0) (r2 p b (At4 I1 I0) (At4 I0 I0)) (r2 p b (At4 I1 I1) (At4 I0 I2)) (r3 p b (At4 I2 I1) (At4 I2 I2) (At4 I2 I3)) no-sq4s no-sq4s no-sq4s no-sq4s no-sq4s c0 c1 c2 c3 c4 c5 c6 c7
