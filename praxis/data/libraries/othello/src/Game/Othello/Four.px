module Game.Othello.Four where

import "base" Data.Bool as B
import "base" Data.List as L
import "base" Data.Maybe as M
import "base" Data.Nat as N
import "base" Data.Nat.Order as O
import Game.Othello.Board as C
import Game.Othello.Rules as R
import Game.Othello.Initial as I
import Game.Othello.Certificate as K
open L using (List, Nil, (::), (<>))

-- Dedicated 4x4 representation with constant-time cell access and
-- three-ray capture evaluation, proved equivalent to the general rules.
data I4 = I0 | I1 | I2 | I3
open I4 public

to-nat4 : I4 -> Nat
to-nat4 I0 = 0
to-nat4 I1 = 1
to-nat4 I2 = 2
to-nat4 I3 = 3

data Sq4 = At4 I4 I4
open Sq4 public

to-sq4 : Sq4 -> C.Square
to-sq4 (At4 r c) = C.At (to-nat4 r) (to-nat4 c)

to-sq4s : List Sq4 -> List C.Square
to-sq4s Nil = Nil
to-sq4s (s :: ss) = to-sq4 s :: to-sq4s ss

private
  to-sq4s-append : (xs ys : List Sq4) -> to-sq4s (xs <> ys) = (to-sq4s xs <> to-sq4s ys)
  to-sq4s-append Nil ys = rfl
  to-sq4s-append (x :: xs) ys = cong (to-sq4s-append xs ys)

  to-sq4s-eq-map : (xs : List Sq4) -> L.map to-sq4 xs = to-sq4s xs
  to-sq4s-eq-map Nil = rfl
  to-sq4s-eq-map (x :: xs) = calc
    L.map to-sq4 (x :: xs)
    = to-sq4 x :: L.map to-sq4 xs
    = to-sq4 x :: to-sq4s xs := cong (to-sq4s-eq-map xs)
    = to-sq4s (x :: xs)

data Row4 = MkRow4 C.Cell C.Cell C.Cell C.Cell
open Row4 public

data Board4 = Grid4 Row4 Row4 Row4 Row4
open Board4 public

private
  no-cells : List C.Cell
  no-cells = Nil

  no-sq4s : List Sq4
  no-sq4s = Nil

row-cells : Row4 -> List C.Cell -> List C.Cell
row-cells (MkRow4 c0 c1 c2 c3) rest = c0 :: c1 :: c2 :: c3 :: rest

to-board : Board4 -> C.Board
to-board (Grid4 r0 r1 r2 r3) = C.Grid 4 (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells))))

private
  row-cells-length : (r : Row4) -> (rest : List C.Cell) -> L.length (row-cells r rest) = S (S (S (S (L.length rest))))
  row-cells-length (MkRow4 c0 c1 c2 c3) rest = rfl

well-formed-4 : (b : Board4) -> C.well-formed (to-board b) = B.True
well-formed-4 (Grid4 r0 r1 r2 r3) = calc
  C.well-formed (to-board (Grid4 r0 r1 r2 r3))
  = B.equal-nat (L.length (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells))))) (4 * 4)
  = B.equal-nat (S (S (S (S (L.length (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))))))) (4 * 4) := cong (row-cells-length r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells))))
  = B.equal-nat (S (S (S (S (S (S (S (S (L.length (row-cells r2 (row-cells r3 no-cells))))))))))) (4 * 4) := cong (row-cells-length r1 (row-cells r2 (row-cells r3 no-cells)))
  = B.equal-nat (S (S (S (S (S (S (S (S (S (S (S (S (L.length (row-cells r3 no-cells)))))))))))))) (4 * 4) := cong (row-cells-length r2 (row-cells r3 no-cells))
  = B.equal-nat (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (L.length no-cells))))))))))))))))) (4 * 4) := cong (row-cells-length r3 no-cells)
  = B.equal-nat 16 (4 * 4)
  = B.True := by decide

get-row : I4 -> Board4 -> Row4
get-row I0 (Grid4 r0 r1 r2 r3) = r0
get-row I1 (Grid4 r0 r1 r2 r3) = r1
get-row I2 (Grid4 r0 r1 r2 r3) = r2
get-row I3 (Grid4 r0 r1 r2 r3) = r3

get-cell : I4 -> Row4 -> C.Cell
get-cell I0 (MkRow4 c0 c1 c2 c3) = c0
get-cell I1 (MkRow4 c0 c1 c2 c3) = c1
get-cell I2 (MkRow4 c0 c1 c2 c3) = c2
get-cell I3 (MkRow4 c0 c1 c2 c3) = c3

read4 : Sq4 -> Board4 -> C.Cell
read4 (At4 r c) b = get-cell c (get-row r b)

set-row : I4 -> Row4 -> Board4 -> Board4
set-row I0 r (Grid4 r0 r1 r2 r3) = Grid4 r r1 r2 r3
set-row I1 r (Grid4 r0 r1 r2 r3) = Grid4 r0 r r2 r3
set-row I2 r (Grid4 r0 r1 r2 r3) = Grid4 r0 r1 r r3
set-row I3 r (Grid4 r0 r1 r2 r3) = Grid4 r0 r1 r2 r

set-cell : I4 -> C.Cell -> Row4 -> Row4
set-cell I0 x (MkRow4 c0 c1 c2 c3) = MkRow4 x c1 c2 c3
set-cell I1 x (MkRow4 c0 c1 c2 c3) = MkRow4 c0 x c2 c3
set-cell I2 x (MkRow4 c0 c1 c2 c3) = MkRow4 c0 c1 x c3
set-cell I3 x (MkRow4 c0 c1 c2 c3) = MkRow4 c0 c1 c2 x

write4 : Sq4 -> C.Cell -> Board4 -> Board4
write4 (At4 r c) x b = set-row r (set-cell c x (get-row r b)) b

private
  less-nat-4 : (i : I4) -> B.less-nat (to-nat4 i) 4 = B.True
  less-nat-4 I0 = rfl
  less-nat-4 I1 = rfl
  less-nat-4 I2 = rfl
  less-nat-4 I3 = rfl

  inside4 : (r c : I4) -> C.inside 4 (C.At (to-nat4 r) (to-nat4 c)) = B.True
  inside4 r c = calc
    C.inside 4 (C.At (to-nat4 r) (to-nat4 c))
    = B.and (B.less-nat (to-nat4 r) 4) (B.less-nat (to-nat4 c) 4)
    = B.and B.True (B.less-nat (to-nat4 c) 4) := cong (less-nat-4 r)
    = B.less-nat (to-nat4 c) 4
    = B.True := less-nat-4 c

  lookup-row0-cells : (c : I4) -> (c0 c1 c2 c3 : C.Cell) -> (rest : List C.Cell) -> L.lookup (to-nat4 c) (row-cells (MkRow4 c0 c1 c2 c3) rest) = M.Just (get-cell c (MkRow4 c0 c1 c2 c3))
  lookup-row0-cells I0 c0 c1 c2 c3 rest = rfl
  lookup-row0-cells I1 c0 c1 c2 c3 rest = rfl
  lookup-row0-cells I2 c0 c1 c2 c3 rest = rfl
  lookup-row0-cells I3 c0 c1 c2 c3 rest = rfl

  lookup-row0 : (c : I4) -> (r : Row4) -> (rest : List C.Cell) -> L.lookup (to-nat4 c) (row-cells r rest) = M.Just (get-cell c r)
  lookup-row0 c (MkRow4 c0 c1 c2 c3) rest = lookup-row0-cells c c0 c1 c2 c3 rest

  lookup-skip-row : (n : Nat) -> (r : Row4) -> (rest : List C.Cell) -> L.lookup (S (S (S (S n)))) (row-cells r rest) = L.lookup n rest
  lookup-skip-row n (MkRow4 c0 c1 c2 c3) rest = rfl

  index4-0 : (c : I4) -> 4 * 0 + to-nat4 c = to-nat4 c
  index4-0 I0 = rfl
  index4-0 I1 = rfl
  index4-0 I2 = rfl
  index4-0 I3 = rfl

  index4-1 : (c : I4) -> 4 * 1 + to-nat4 c = S (S (S (S (to-nat4 c))))
  index4-1 I0 = rfl
  index4-1 I1 = rfl
  index4-1 I2 = rfl
  index4-1 I3 = rfl

  index4-2 : (c : I4) -> 4 * 2 + to-nat4 c = S (S (S (S (S (S (S (S (to-nat4 c))))))))
  index4-2 I0 = rfl
  index4-2 I1 = rfl
  index4-2 I2 = rfl
  index4-2 I3 = rfl

  index4-3 : (c : I4) -> 4 * 3 + to-nat4 c = S (S (S (S (S (S (S (S (S (S (S (S (to-nat4 c))))))))))))
  index4-3 I0 = rfl
  index4-3 I1 = rfl
  index4-3 I2 = rfl
  index4-3 I3 = rfl

  lookup4-eq : (r c : I4) -> (r0 r1 r2 r3 : Row4) -> L.lookup (C.index 4 (C.At (to-nat4 r) (to-nat4 c))) (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))) = M.Just (get-cell c (get-row r (Grid4 r0 r1 r2 r3)))
  lookup4-eq I0 c r0 r1 r2 r3 = calc
    L.lookup (4 * 0 + to-nat4 c) (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells))))
    = L.lookup (to-nat4 c) (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))) := cong (index4-0 c)
    = M.Just (get-cell c r0) := lookup-row0 c r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))
  lookup4-eq I1 c r0 r1 r2 r3 = calc
    L.lookup (4 * 1 + to-nat4 c) (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells))))
    = L.lookup (S (S (S (S (to-nat4 c))))) (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))) := cong (index4-1 c)
    = L.lookup (to-nat4 c) (row-cells r1 (row-cells r2 (row-cells r3 no-cells))) := lookup-skip-row (to-nat4 c) r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))
    = M.Just (get-cell c r1) := lookup-row0 c r1 (row-cells r2 (row-cells r3 no-cells))
  lookup4-eq I2 c r0 r1 r2 r3 = calc
    L.lookup (4 * 2 + to-nat4 c) (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells))))
    = L.lookup (S (S (S (S (S (S (S (S (to-nat4 c))))))))) (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))) := cong (index4-2 c)
    = L.lookup (S (S (S (S (to-nat4 c))))) (row-cells r1 (row-cells r2 (row-cells r3 no-cells))) := lookup-skip-row (S (S (S (S (to-nat4 c))))) r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))
    = L.lookup (to-nat4 c) (row-cells r2 (row-cells r3 no-cells)) := lookup-skip-row (to-nat4 c) r1 (row-cells r2 (row-cells r3 no-cells))
    = M.Just (get-cell c r2) := lookup-row0 c r2 (row-cells r3 no-cells)
  lookup4-eq I3 c r0 r1 r2 r3 = calc
    L.lookup (4 * 3 + to-nat4 c) (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells))))
    = L.lookup (S (S (S (S (S (S (S (S (S (S (S (S (to-nat4 c))))))))))))) (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))) := cong (index4-3 c)
    = L.lookup (S (S (S (S (S (S (S (S (to-nat4 c))))))))) (row-cells r1 (row-cells r2 (row-cells r3 no-cells))) := lookup-skip-row (S (S (S (S (S (S (S (S (to-nat4 c))))))))) r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))
    = L.lookup (S (S (S (S (to-nat4 c))))) (row-cells r2 (row-cells r3 no-cells)) := lookup-skip-row (S (S (S (S (to-nat4 c))))) r1 (row-cells r2 (row-cells r3 no-cells))
    = L.lookup (to-nat4 c) (row-cells r3 no-cells) := lookup-skip-row (to-nat4 c) r2 (row-cells r3 no-cells)
    = M.Just (get-cell c r3) := lookup-row0 c r3 no-cells

  read4-eq-rc : (r c : I4) -> (b : Board4) -> C.read (C.At (to-nat4 r) (to-nat4 c)) (to-board b) = M.Just (get-cell c (get-row r b))
  read4-eq-rc r c (Grid4 r0 r1 r2 r3) = calc
    C.read (C.At (to-nat4 r) (to-nat4 c)) (to-board (Grid4 r0 r1 r2 r3))
    = B.choose (C.inside 4 (C.At (to-nat4 r) (to-nat4 c))) (L.lookup (C.index 4 (C.At (to-nat4 r) (to-nat4 c))) (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells))))) M.Nothing
    = B.choose B.True (L.lookup (C.index 4 (C.At (to-nat4 r) (to-nat4 c))) (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells))))) M.Nothing := cong (inside4 r c)
    = L.lookup (C.index 4 (C.At (to-nat4 r) (to-nat4 c))) (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells))))
    = M.Just (get-cell c (get-row r (Grid4 r0 r1 r2 r3))) := lookup4-eq r c r0 r1 r2 r3

read4-eq : (s : Sq4) -> (b : Board4) -> C.read (to-sq4 s) (to-board b) = M.Just (read4 s b)
read4-eq (At4 r c) b = read4-eq-rc r c b

private
  update-row0-cells : (c : I4) -> (x c0 c1 c2 c3 : C.Cell) -> (rest : List C.Cell) -> L.update (to-nat4 c) x (row-cells (MkRow4 c0 c1 c2 c3) rest) = row-cells (set-cell c x (MkRow4 c0 c1 c2 c3)) rest
  update-row0-cells I0 x c0 c1 c2 c3 rest = rfl
  update-row0-cells I1 x c0 c1 c2 c3 rest = rfl
  update-row0-cells I2 x c0 c1 c2 c3 rest = rfl
  update-row0-cells I3 x c0 c1 c2 c3 rest = rfl

  update-row0 : (c : I4) -> (x : C.Cell) -> (r : Row4) -> (rest : List C.Cell) -> L.update (to-nat4 c) x (row-cells r rest) = row-cells (set-cell c x r) rest
  update-row0 c x (MkRow4 c0 c1 c2 c3) rest = update-row0-cells c x c0 c1 c2 c3 rest

  update-skip-row : (n : Nat) -> (x : C.Cell) -> (r : Row4) -> (rest : List C.Cell) -> L.update (S (S (S (S n)))) x (row-cells r rest) = row-cells r (L.update n x rest)
  update-skip-row n x (MkRow4 c0 c1 c2 c3) rest = rfl

  update4-eq : (r c : I4) -> (x : C.Cell) -> (r0 r1 r2 r3 : Row4) -> L.update (C.index 4 (C.At (to-nat4 r) (to-nat4 c))) x (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))) = C.cells (to-board (write4 (At4 r c) x (Grid4 r0 r1 r2 r3)))
  update4-eq I0 c x r0 r1 r2 r3 = calc
    L.update (4 * 0 + to-nat4 c) x (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells))))
    = L.update (to-nat4 c) x (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))) := cong (index4-0 c)
    = row-cells (set-cell c x r0) (row-cells r1 (row-cells r2 (row-cells r3 no-cells))) := update-row0 c x r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))
  update4-eq I1 c x r0 r1 r2 r3 = calc
    L.update (4 * 1 + to-nat4 c) x (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells))))
    = L.update (S (S (S (S (to-nat4 c))))) x (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))) := cong (index4-1 c)
    = row-cells r0 (L.update (to-nat4 c) x (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))) := update-skip-row (to-nat4 c) x r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))
    = row-cells r0 (row-cells (set-cell c x r1) (row-cells r2 (row-cells r3 no-cells))) := cong (update-row0 c x r1 (row-cells r2 (row-cells r3 no-cells)))
  update4-eq I2 c x r0 r1 r2 r3 = calc
    L.update (4 * 2 + to-nat4 c) x (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells))))
    = L.update (S (S (S (S (S (S (S (S (to-nat4 c))))))))) x (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))) := cong (index4-2 c)
    = row-cells r0 (L.update (S (S (S (S (to-nat4 c))))) x (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))) := update-skip-row (S (S (S (S (to-nat4 c))))) x r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))
    = row-cells r0 (row-cells r1 (L.update (to-nat4 c) x (row-cells r2 (row-cells r3 no-cells)))) := cong (update-skip-row (to-nat4 c) x r1 (row-cells r2 (row-cells r3 no-cells)))
    = row-cells r0 (row-cells r1 (row-cells (set-cell c x r2) (row-cells r3 no-cells))) := cong (update-row0 c x r2 (row-cells r3 no-cells))
  update4-eq I3 c x r0 r1 r2 r3 = calc
    L.update (4 * 3 + to-nat4 c) x (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells))))
    = L.update (S (S (S (S (S (S (S (S (S (S (S (S (to-nat4 c))))))))))))) x (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))) := cong (index4-3 c)
    = row-cells r0 (L.update (S (S (S (S (S (S (S (S (to-nat4 c))))))))) x (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))) := update-skip-row (S (S (S (S (S (S (S (S (to-nat4 c))))))))) x r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))
    = row-cells r0 (row-cells r1 (L.update (S (S (S (S (to-nat4 c))))) x (row-cells r2 (row-cells r3 no-cells)))) := cong (update-skip-row (S (S (S (S (to-nat4 c))))) x r1 (row-cells r2 (row-cells r3 no-cells)))
    = row-cells r0 (row-cells r1 (row-cells r2 (L.update (to-nat4 c) x (row-cells r3 no-cells)))) := cong (update-skip-row (to-nat4 c) x r2 (row-cells r3 no-cells))
    = row-cells r0 (row-cells r1 (row-cells r2 (row-cells (set-cell c x r3) no-cells))) := cong (update-row0 c x r3 no-cells)

  grid-cells : (b : Board4) -> C.Grid 4 (C.cells (to-board b)) = to-board b
  grid-cells (Grid4 r0 r1 r2 r3) = rfl

  write4-eq-rc : (r c : I4) -> (x : C.Cell) -> (b : Board4) -> C.write (C.At (to-nat4 r) (to-nat4 c)) x (to-board b) = to-board (write4 (At4 r c) x b)
  write4-eq-rc r c x (Grid4 r0 r1 r2 r3) = by
    have hi : C.inside 4 (C.At (to-nat4 r) (to-nat4 c)) = B.True := inside4 r c
    calc
      C.write (C.At (to-nat4 r) (to-nat4 c)) x (C.Grid 4 (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))))
      = C.Grid 4 (L.update (C.index 4 (C.At (to-nat4 r) (to-nat4 c))) x (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells))))) := C.write-inside (C.At (to-nat4 r) (to-nat4 c)) x 4 (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))) hi
      = C.Grid 4 (C.cells (to-board (write4 (At4 r c) x (Grid4 r0 r1 r2 r3)))) := cong (update4-eq r c x r0 r1 r2 r3)
      = to-board (write4 (At4 r c) x (Grid4 r0 r1 r2 r3)) := grid-cells (write4 (At4 r c) x (Grid4 r0 r1 r2 r3))

write4-eq : (s : Sq4) -> (x : C.Cell) -> (b : Board4) -> C.write (to-sq4 s) x (to-board b) = to-board (write4 s x b)
write4-eq (At4 r c) x b = write4-eq-rc r c x b

-- Fast disc counting and tournament scoring on Board4.
row-count : C.Player -> Row4 -> Nat
row-count p (MkRow4 c0 c1 c2 c3) = C.owned-cell p c0 + (C.owned-cell p c1 + (C.owned-cell p c2 + C.owned-cell p c3))

count4 : C.Player -> Board4 -> Nat
count4 p (Grid4 r0 r1 r2 r3) = row-count p r0 + (row-count p r1 + (row-count p r2 + row-count p r3))

private
  sum-row-cells : (p : C.Player) -> (r : Row4) -> (rest : List C.Cell) -> L.sum (L.map (\x -> C.owned-cell p x) (row-cells r rest)) = row-count p r + L.sum (L.map (\x -> C.owned-cell p x) rest)
  sum-row-cells p (MkRow4 c0 c1 c2 c3) rest = calc
    C.owned-cell p c0 + (C.owned-cell p c1 + (C.owned-cell p c2 + (C.owned-cell p c3 + L.sum (L.map (\x -> C.owned-cell p x) rest))))
    = C.owned-cell p c0 + (C.owned-cell p c1 + ((C.owned-cell p c2 + C.owned-cell p c3) + L.sum (L.map (\x -> C.owned-cell p x) rest))) := cong addAssoc
    = C.owned-cell p c0 + ((C.owned-cell p c1 + (C.owned-cell p c2 + C.owned-cell p c3)) + L.sum (L.map (\x -> C.owned-cell p x) rest)) := cong addAssoc
    = (C.owned-cell p c0 + (C.owned-cell p c1 + (C.owned-cell p c2 + C.owned-cell p c3))) + L.sum (L.map (\x -> C.owned-cell p x) rest) := cong addAssoc

count4-eq : (p : C.Player) -> (b : Board4) -> C.count p (to-board b) = count4 p b
count4-eq p (Grid4 r0 r1 r2 r3) = calc
  C.count p (to-board (Grid4 r0 r1 r2 r3))
  = L.sum (L.map (\x -> C.owned-cell p x) (row-cells r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))))
  = row-count p r0 + L.sum (L.map (\x -> C.owned-cell p x) (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))) := sum-row-cells p r0 (row-cells r1 (row-cells r2 (row-cells r3 no-cells)))
  = row-count p r0 + (row-count p r1 + L.sum (L.map (\x -> C.owned-cell p x) (row-cells r2 (row-cells r3 no-cells)))) := cong (sum-row-cells p r1 (row-cells r2 (row-cells r3 no-cells)))
  = row-count p r0 + (row-count p r1 + (row-count p r2 + L.sum (L.map (\x -> C.owned-cell p x) (row-cells r3 no-cells)))) := cong (sum-row-cells p r2 (row-cells r3 no-cells))
  = row-count p r0 + (row-count p r1 + (row-count p r2 + (row-count p r3 + L.sum (L.map (\x -> C.owned-cell p x) no-cells)))) := cong (sum-row-cells p r3 no-cells)
  = count4 p (Grid4 r0 r1 r2 r3)

white-score4 : Board4 -> Nat
white-score4 b = B.choose (B.less-nat (count4 C.Black b) (count4 C.White b)) (16 - count4 C.Black b) (B.choose (B.less-nat (count4 C.White b) (count4 C.Black b)) (count4 C.White b) 8)

private
  div-16-2 : N.(/) (4 * 4) 2 = 8
  div-16-2 = by decide

  size-to-board : (b : Board4) -> C.size (to-board b) = 4
  size-to-board (Grid4 r0 r1 r2 r3) = rfl

white-score4-eq : (b : Board4) -> K.white-score (to-board b) = white-score4 b
white-score4-eq b = calc
  K.white-score (to-board b)
  = B.choose (B.less-nat (C.count C.Black (to-board b)) (C.count C.White (to-board b))) (C.size (to-board b) * C.size (to-board b) - C.count C.Black (to-board b)) (B.choose (B.less-nat (C.count C.White (to-board b)) (C.count C.Black (to-board b))) (C.count C.White (to-board b)) (N.(/) (C.size (to-board b) * C.size (to-board b)) 2))
  = B.choose (B.less-nat (C.count C.Black (to-board b)) (C.count C.White (to-board b))) (4 * 4 - C.count C.Black (to-board b)) (B.choose (B.less-nat (C.count C.White (to-board b)) (C.count C.Black (to-board b))) (C.count C.White (to-board b)) (N.(/) (4 * 4) 2)) := cong (size-to-board b)
  = B.choose (B.less-nat (C.count C.Black (to-board b)) (C.count C.White (to-board b))) (4 * 4 - C.count C.Black (to-board b)) (B.choose (B.less-nat (C.count C.White (to-board b)) (C.count C.Black (to-board b))) (C.count C.White (to-board b)) 8) := cong div-16-2
  = B.choose (B.less-nat (C.count C.Black (to-board b)) (C.count C.White (to-board b))) (16 - C.count C.Black (to-board b)) (B.choose (B.less-nat (C.count C.White (to-board b)) (C.count C.Black (to-board b))) (C.count C.White (to-board b)) 8)
  = B.choose (B.less-nat (count4 C.Black b) (C.count C.White (to-board b))) (16 - count4 C.Black b) (B.choose (B.less-nat (C.count C.White (to-board b)) (count4 C.Black b)) (C.count C.White (to-board b)) 8) := cong (count4-eq C.Black b)
  = white-score4 b := cong (count4-eq C.White b)

-- Every square on a 4x4 board has exactly 3 rays of length 2 or 3.
private
  r2 : C.Player -> Board4 -> Sq4 -> Sq4 -> List Sq4
  r2 p b s1 s2 = R.ray-two p s1 (read4 s1 b) (read4 s2 b)

  r3 : C.Player -> Board4 -> Sq4 -> Sq4 -> Sq4 -> List Sq4
  r3 p b s1 s2 s3 = R.ray-three p s1 s2 (read4 s1 b) (read4 s2 b) (read4 s3 b)

  captures4-r0 : C.Player -> Board4 -> I4 -> List Sq4
  captures4-r0 p b I0 = r3 p b (At4 I0 I1) (At4 I0 I2) (At4 I0 I3) <> (r3 p b (At4 I1 I1) (At4 I2 I2) (At4 I3 I3) <> r3 p b (At4 I1 I0) (At4 I2 I0) (At4 I3 I0))
  captures4-r0 p b I1 = r2 p b (At4 I0 I2) (At4 I0 I3) <> (r2 p b (At4 I1 I2) (At4 I2 I3) <> r3 p b (At4 I1 I1) (At4 I2 I1) (At4 I3 I1))
  captures4-r0 p b I2 = r3 p b (At4 I1 I2) (At4 I2 I2) (At4 I3 I2) <> (r2 p b (At4 I1 I1) (At4 I2 I0) <> r2 p b (At4 I0 I1) (At4 I0 I0))
  captures4-r0 p b I3 = r3 p b (At4 I1 I3) (At4 I2 I3) (At4 I3 I3) <> (r3 p b (At4 I1 I2) (At4 I2 I1) (At4 I3 I0) <> r3 p b (At4 I0 I2) (At4 I0 I1) (At4 I0 I0))

  captures4-r1 : C.Player -> Board4 -> I4 -> List Sq4
  captures4-r1 p b I0 = r3 p b (At4 I1 I1) (At4 I1 I2) (At4 I1 I3) <> (r2 p b (At4 I2 I1) (At4 I3 I2) <> r2 p b (At4 I2 I0) (At4 I3 I0))
  captures4-r1 p b I1 = r2 p b (At4 I1 I2) (At4 I1 I3) <> (r2 p b (At4 I2 I2) (At4 I3 I3) <> r2 p b (At4 I2 I1) (At4 I3 I1))
  captures4-r1 p b I2 = r2 p b (At4 I2 I2) (At4 I3 I2) <> (r2 p b (At4 I2 I1) (At4 I3 I0) <> r2 p b (At4 I1 I1) (At4 I1 I0))
  captures4-r1 p b I3 = r2 p b (At4 I2 I3) (At4 I3 I3) <> (r2 p b (At4 I2 I2) (At4 I3 I1) <> r3 p b (At4 I1 I2) (At4 I1 I1) (At4 I1 I0))

  captures4-r2 : C.Player -> Board4 -> I4 -> List Sq4
  captures4-r2 p b I0 = r2 p b (At4 I1 I0) (At4 I0 I0) <> (r2 p b (At4 I1 I1) (At4 I0 I2) <> r3 p b (At4 I2 I1) (At4 I2 I2) (At4 I2 I3))
  captures4-r2 p b I1 = r2 p b (At4 I1 I1) (At4 I0 I1) <> (r2 p b (At4 I1 I2) (At4 I0 I3) <> r2 p b (At4 I2 I2) (At4 I2 I3))
  captures4-r2 p b I2 = r2 p b (At4 I1 I2) (At4 I0 I2) <> (r2 p b (At4 I2 I1) (At4 I2 I0) <> r2 p b (At4 I1 I1) (At4 I0 I0))
  captures4-r2 p b I3 = r2 p b (At4 I1 I3) (At4 I0 I3) <> (r3 p b (At4 I2 I2) (At4 I2 I1) (At4 I2 I0) <> r2 p b (At4 I1 I2) (At4 I0 I1))

  captures4-r3 : C.Player -> Board4 -> I4 -> List Sq4
  captures4-r3 p b I0 = r3 p b (At4 I2 I0) (At4 I1 I0) (At4 I0 I0) <> (r3 p b (At4 I2 I1) (At4 I1 I2) (At4 I0 I3) <> r3 p b (At4 I3 I1) (At4 I3 I2) (At4 I3 I3))
  captures4-r3 p b I1 = r3 p b (At4 I2 I1) (At4 I1 I1) (At4 I0 I1) <> (r2 p b (At4 I2 I2) (At4 I1 I3) <> r2 p b (At4 I3 I2) (At4 I3 I3))
  captures4-r3 p b I2 = r3 p b (At4 I2 I2) (At4 I1 I2) (At4 I0 I2) <> (r2 p b (At4 I3 I1) (At4 I3 I0) <> r2 p b (At4 I2 I1) (At4 I1 I0))
  captures4-r3 p b I3 = r3 p b (At4 I2 I3) (At4 I1 I3) (At4 I0 I3) <> (r3 p b (At4 I3 I2) (At4 I3 I1) (At4 I3 I0) <> r3 p b (At4 I2 I2) (At4 I1 I1) (At4 I0 I0))

  captures4-at : C.Player -> Board4 -> I4 -> I4 -> List Sq4
  captures4-at p b I0 c = captures4-r0 p b c
  captures4-at p b I1 c = captures4-r1 p b c
  captures4-at p b I2 c = captures4-r2 p b c
  captures4-at p b I3 c = captures4-r3 p b c

captures4 : C.Player -> Board4 -> Sq4 -> List Sq4
captures4 p b (At4 r c) = captures4-at p b r c

private
  eval0 : (p : C.Player) -> (b : Board4) -> (s : Sq4) -> (d : R.Direction) -> R.ray 4 d (to-sq4 s) = Nil -> R.captures-on p (to-board b) (to-sq4 s) d = to-sq4s no-sq4s
  eval0 p b s d hr = by
    have hr' : R.ray (C.size (to-board b)) d (to-sq4 s) = Nil := calc
      R.ray (C.size (to-board b)) d (to-sq4 s)
      = R.ray 4 d (to-sq4 s) := cong (size-to-board b)
      = Nil := hr
    calc
      R.captures-on p (to-board b) (to-sq4 s) d
      = Nil := R.captures-on-nil p (to-board b) (to-sq4 s) d hr'
      = to-sq4s no-sq4s

  eval1 : (p : C.Player) -> (b : Board4) -> (s : Sq4) -> (d : R.Direction) -> (s1 : Sq4) -> R.ray 4 d (to-sq4 s) = to-sq4 s1 :: Nil -> R.captures-on p (to-board b) (to-sq4 s) d = to-sq4s no-sq4s
  eval1 p b s d s1 hr = by
    have hr' : R.ray (C.size (to-board b)) d (to-sq4 s) = to-sq4 s1 :: Nil := calc
      R.ray (C.size (to-board b)) d (to-sq4 s)
      = R.ray 4 d (to-sq4 s) := cong (size-to-board b)
      = to-sq4 s1 :: Nil := hr
    have h1 : C.read (to-sq4 s1) (to-board b) = M.Just (read4 s1 b) := read4-eq s1 b
    calc
      R.captures-on p (to-board b) (to-sq4 s) d
      = Nil := R.captures-on-one p (to-board b) (to-sq4 s) d (to-sq4 s1) (read4 s1 b) hr' h1
      = to-sq4s no-sq4s

  eval2 : (p : C.Player) -> (b : Board4) -> (s : Sq4) -> (d : R.Direction) -> (s1 s2 : Sq4) -> R.ray 4 d (to-sq4 s) = to-sq4 s1 :: to-sq4 s2 :: Nil -> R.captures-on p (to-board b) (to-sq4 s) d = to-sq4s (r2 p b s1 s2)
  eval2 p b s d s1 s2 hr = by
    have hr' : R.ray (C.size (to-board b)) d (to-sq4 s) = to-sq4 s1 :: to-sq4 s2 :: Nil := calc
      R.ray (C.size (to-board b)) d (to-sq4 s)
      = R.ray 4 d (to-sq4 s) := cong (size-to-board b)
      = to-sq4 s1 :: to-sq4 s2 :: Nil := hr
    have h1 : C.read (to-sq4 s1) (to-board b) = M.Just (read4 s1 b) := read4-eq s1 b
    have h2 : C.read (to-sq4 s2) (to-board b) = M.Just (read4 s2 b) := read4-eq s2 b
    calc
      R.captures-on p (to-board b) (to-sq4 s) d
      = R.ray-two p (to-sq4 s1) (read4 s1 b) (read4 s2 b) := R.captures-on-two p (to-board b) (to-sq4 s) d (to-sq4 s1) (to-sq4 s2) (read4 s1 b) (read4 s2 b) hr' h1 h2
      = L.map to-sq4 (R.ray-two p s1 (read4 s1 b) (read4 s2 b)) := cong (R.map-ray-two to-sq4 p s1 (read4 s1 b) (read4 s2 b))
      = L.map to-sq4 (r2 p b s1 s2)
      = to-sq4s (r2 p b s1 s2) := to-sq4s-eq-map (r2 p b s1 s2)

  eval3 : (p : C.Player) -> (b : Board4) -> (s : Sq4) -> (d : R.Direction) -> (s1 s2 s3 : Sq4) -> R.ray 4 d (to-sq4 s) = to-sq4 s1 :: to-sq4 s2 :: to-sq4 s3 :: Nil -> R.captures-on p (to-board b) (to-sq4 s) d = to-sq4s (r3 p b s1 s2 s3)
  eval3 p b s d s1 s2 s3 hr = by
    have hr' : R.ray (C.size (to-board b)) d (to-sq4 s) = to-sq4 s1 :: to-sq4 s2 :: to-sq4 s3 :: Nil := calc
      R.ray (C.size (to-board b)) d (to-sq4 s)
      = R.ray 4 d (to-sq4 s) := cong (size-to-board b)
      = to-sq4 s1 :: to-sq4 s2 :: to-sq4 s3 :: Nil := hr
    have h1 : C.read (to-sq4 s1) (to-board b) = M.Just (read4 s1 b) := read4-eq s1 b
    have h2 : C.read (to-sq4 s2) (to-board b) = M.Just (read4 s2 b) := read4-eq s2 b
    have h3 : C.read (to-sq4 s3) (to-board b) = M.Just (read4 s3 b) := read4-eq s3 b
    calc
      R.captures-on p (to-board b) (to-sq4 s) d
      = R.ray-three p (to-sq4 s1) (to-sq4 s2) (read4 s1 b) (read4 s2 b) (read4 s3 b) := R.captures-on-three p (to-board b) (to-sq4 s) d (to-sq4 s1) (to-sq4 s2) (to-sq4 s3) (read4 s1 b) (read4 s2 b) (read4 s3 b) hr' h1 h2 h3
      = L.map to-sq4 (R.ray-three p s1 s2 (read4 s1 b) (read4 s2 b) (read4 s3 b)) := cong (R.map-ray-three to-sq4 p s1 s2 (read4 s1 b) (read4 s2 b) (read4 s3 b))
      = L.map to-sq4 (r3 p b s1 s2 s3)
      = to-sq4s (r3 p b s1 s2 s3) := to-sq4s-eq-map (r3 p b s1 s2 s3)

  combine8 : (p : C.Player) -> (b : Board4) -> (s : Sq4) -> (x0 x1 x2 x3 x4 x5 x6 x7 : List Sq4) ->
    R.captures-on p (to-board b) (to-sq4 s) R.North = to-sq4s x0 ->
    R.captures-on p (to-board b) (to-sq4 s) R.NorthEast = to-sq4s x1 ->
    R.captures-on p (to-board b) (to-sq4 s) R.East = to-sq4s x2 ->
    R.captures-on p (to-board b) (to-sq4 s) R.SouthEast = to-sq4s x3 ->
    R.captures-on p (to-board b) (to-sq4 s) R.South = to-sq4s x4 ->
    R.captures-on p (to-board b) (to-sq4 s) R.SouthWest = to-sq4s x5 ->
    R.captures-on p (to-board b) (to-sq4 s) R.West = to-sq4s x6 ->
    R.captures-on p (to-board b) (to-sq4 s) R.NorthWest = to-sq4s x7 ->
    R.captures p (to-board b) (to-sq4 s) = to-sq4s (x0 <> (x1 <> (x2 <> (x3 <> (x4 <> (x5 <> (x6 <> (x7 <> no-sq4s))))))))
  combine8 p b s x0 x1 x2 x3 x4 x5 x6 x7 h0 h1 h2 h3 h4 h5 h6 h7 = calc
    R.captures p (to-board b) (to-sq4 s)
    = R.captures-on p (to-board b) (to-sq4 s) R.North <> (R.captures-on p (to-board b) (to-sq4 s) R.NorthEast <> (R.captures-on p (to-board b) (to-sq4 s) R.East <> (R.captures-on p (to-board b) (to-sq4 s) R.SouthEast <> (R.captures-on p (to-board b) (to-sq4 s) R.South <> (R.captures-on p (to-board b) (to-sq4 s) R.SouthWest <> (R.captures-on p (to-board b) (to-sq4 s) R.West <> (R.captures-on p (to-board b) (to-sq4 s) R.NorthWest <> Nil)))))))
    = to-sq4s x0 <> (R.captures-on p (to-board b) (to-sq4 s) R.NorthEast <> (R.captures-on p (to-board b) (to-sq4 s) R.East <> (R.captures-on p (to-board b) (to-sq4 s) R.SouthEast <> (R.captures-on p (to-board b) (to-sq4 s) R.South <> (R.captures-on p (to-board b) (to-sq4 s) R.SouthWest <> (R.captures-on p (to-board b) (to-sq4 s) R.West <> (R.captures-on p (to-board b) (to-sq4 s) R.NorthWest <> Nil))))))) := cong h0
    = to-sq4s x0 <> (to-sq4s x1 <> (R.captures-on p (to-board b) (to-sq4 s) R.East <> (R.captures-on p (to-board b) (to-sq4 s) R.SouthEast <> (R.captures-on p (to-board b) (to-sq4 s) R.South <> (R.captures-on p (to-board b) (to-sq4 s) R.SouthWest <> (R.captures-on p (to-board b) (to-sq4 s) R.West <> (R.captures-on p (to-board b) (to-sq4 s) R.NorthWest <> Nil))))))) := cong h1
    = to-sq4s x0 <> (to-sq4s x1 <> (to-sq4s x2 <> (R.captures-on p (to-board b) (to-sq4 s) R.SouthEast <> (R.captures-on p (to-board b) (to-sq4 s) R.South <> (R.captures-on p (to-board b) (to-sq4 s) R.SouthWest <> (R.captures-on p (to-board b) (to-sq4 s) R.West <> (R.captures-on p (to-board b) (to-sq4 s) R.NorthWest <> Nil))))))) := cong h2
    = to-sq4s x0 <> (to-sq4s x1 <> (to-sq4s x2 <> (to-sq4s x3 <> (R.captures-on p (to-board b) (to-sq4 s) R.South <> (R.captures-on p (to-board b) (to-sq4 s) R.SouthWest <> (R.captures-on p (to-board b) (to-sq4 s) R.West <> (R.captures-on p (to-board b) (to-sq4 s) R.NorthWest <> Nil))))))) := cong h3
    = to-sq4s x0 <> (to-sq4s x1 <> (to-sq4s x2 <> (to-sq4s x3 <> (to-sq4s x4 <> (R.captures-on p (to-board b) (to-sq4 s) R.SouthWest <> (R.captures-on p (to-board b) (to-sq4 s) R.West <> (R.captures-on p (to-board b) (to-sq4 s) R.NorthWest <> Nil))))))) := cong h4
    = to-sq4s x0 <> (to-sq4s x1 <> (to-sq4s x2 <> (to-sq4s x3 <> (to-sq4s x4 <> (to-sq4s x5 <> (R.captures-on p (to-board b) (to-sq4 s) R.West <> (R.captures-on p (to-board b) (to-sq4 s) R.NorthWest <> Nil))))))) := cong h5
    = to-sq4s x0 <> (to-sq4s x1 <> (to-sq4s x2 <> (to-sq4s x3 <> (to-sq4s x4 <> (to-sq4s x5 <> (to-sq4s x6 <> (R.captures-on p (to-board b) (to-sq4 s) R.NorthWest <> Nil))))))) := cong h6
    = to-sq4s x0 <> (to-sq4s x1 <> (to-sq4s x2 <> (to-sq4s x3 <> (to-sq4s x4 <> (to-sq4s x5 <> (to-sq4s x6 <> (to-sq4s x7 <> Nil))))))) := cong h7
    = to-sq4s x0 <> (to-sq4s x1 <> (to-sq4s x2 <> (to-sq4s x3 <> (to-sq4s x4 <> (to-sq4s x5 <> (to-sq4s x6 <> (to-sq4s x7 <> to-sq4s no-sq4s)))))))
    = to-sq4s x0 <> (to-sq4s x1 <> (to-sq4s x2 <> (to-sq4s x3 <> (to-sq4s x4 <> (to-sq4s x5 <> (to-sq4s x6 <> to-sq4s (x7 <> no-sq4s))))))) := cong (to-sq4s-append x7 no-sq4s)
    = to-sq4s x0 <> (to-sq4s x1 <> (to-sq4s x2 <> (to-sq4s x3 <> (to-sq4s x4 <> (to-sq4s x5 <> to-sq4s (x6 <> (x7 <> no-sq4s))))))) := cong (to-sq4s-append x6 (x7 <> no-sq4s))
    = to-sq4s x0 <> (to-sq4s x1 <> (to-sq4s x2 <> (to-sq4s x3 <> (to-sq4s x4 <> to-sq4s (x5 <> (x6 <> (x7 <> no-sq4s))))))) := cong (to-sq4s-append x5 (x6 <> (x7 <> no-sq4s)))
    = to-sq4s x0 <> (to-sq4s x1 <> (to-sq4s x2 <> (to-sq4s x3 <> to-sq4s (x4 <> (x5 <> (x6 <> (x7 <> no-sq4s))))))) := cong (to-sq4s-append x4 (x5 <> (x6 <> (x7 <> no-sq4s))))
    = to-sq4s x0 <> (to-sq4s x1 <> (to-sq4s x2 <> to-sq4s (x3 <> (x4 <> (x5 <> (x6 <> (x7 <> no-sq4s))))))) := cong (to-sq4s-append x3 (x4 <> (x5 <> (x6 <> (x7 <> no-sq4s)))))
    = to-sq4s x0 <> (to-sq4s x1 <> to-sq4s (x2 <> (x3 <> (x4 <> (x5 <> (x6 <> (x7 <> no-sq4s))))))) := cong (to-sq4s-append x2 (x3 <> (x4 <> (x5 <> (x6 <> (x7 <> no-sq4s))))))
    = to-sq4s x0 <> to-sq4s (x1 <> (x2 <> (x3 <> (x4 <> (x5 <> (x6 <> (x7 <> no-sq4s))))))) := cong (to-sq4s-append x1 (x2 <> (x3 <> (x4 <> (x5 <> (x6 <> (x7 <> no-sq4s)))))))
    = to-sq4s (x0 <> (x1 <> (x2 <> (x3 <> (x4 <> (x5 <> (x6 <> (x7 <> no-sq4s)))))))) := cong (to-sq4s-append x0 (x1 <> (x2 <> (x3 <> (x4 <> (x5 <> (x6 <> (x7 <> no-sq4s))))))))

  strip-tail : (a b c : List Sq4) -> to-sq4s (a <> (b <> (c <> no-sq4s))) = to-sq4s (a <> (b <> c))
  strip-tail a b c = calc
    to-sq4s (a <> (b <> (c <> no-sq4s)))
    = to-sq4s (a <> (b <> (c <> Nil)))
    = to-sq4s (a <> (b <> c)) := cong (L.append-nil c)

  captures4-r0-eq : (p : C.Player) -> (b : Board4) -> (c : I4) -> R.captures p (to-board b) (to-sq4 (At4 I0 c)) = to-sq4s (captures4-r0 p b c)
  captures4-r0-eq p b I0 = by
    have r0 : R.ray 4 R.North (to-sq4 (At4 I0 I0)) = Nil := by decide
    have r1 : R.ray 4 R.NorthEast (to-sq4 (At4 I0 I0)) = Nil := by decide
    have r2e : R.ray 4 R.East (to-sq4 (At4 I0 I0)) = to-sq4 (At4 I0 I1) :: to-sq4 (At4 I0 I2) :: to-sq4 (At4 I0 I3) :: Nil := by decide
    have r3e : R.ray 4 R.SouthEast (to-sq4 (At4 I0 I0)) = to-sq4 (At4 I1 I1) :: to-sq4 (At4 I2 I2) :: to-sq4 (At4 I3 I3) :: Nil := by decide
    have r4 : R.ray 4 R.South (to-sq4 (At4 I0 I0)) = to-sq4 (At4 I1 I0) :: to-sq4 (At4 I2 I0) :: to-sq4 (At4 I3 I0) :: Nil := by decide
    have r5 : R.ray 4 R.SouthWest (to-sq4 (At4 I0 I0)) = Nil := by decide
    have r6 : R.ray 4 R.West (to-sq4 (At4 I0 I0)) = Nil := by decide
    have r7 : R.ray 4 R.NorthWest (to-sq4 (At4 I0 I0)) = Nil := by decide
    have c0 : R.captures-on p (to-board b) (to-sq4 (At4 I0 I0)) R.North = to-sq4s no-sq4s := eval0 p b (At4 I0 I0) R.North r0
    have c1 : R.captures-on p (to-board b) (to-sq4 (At4 I0 I0)) R.NorthEast = to-sq4s no-sq4s := eval0 p b (At4 I0 I0) R.NorthEast r1
    have c2 : R.captures-on p (to-board b) (to-sq4 (At4 I0 I0)) R.East = to-sq4s (r3 p b (At4 I0 I1) (At4 I0 I2) (At4 I0 I3)) := eval3 p b (At4 I0 I0) R.East (At4 I0 I1) (At4 I0 I2) (At4 I0 I3) r2e
    have c3 : R.captures-on p (to-board b) (to-sq4 (At4 I0 I0)) R.SouthEast = to-sq4s (r3 p b (At4 I1 I1) (At4 I2 I2) (At4 I3 I3)) := eval3 p b (At4 I0 I0) R.SouthEast (At4 I1 I1) (At4 I2 I2) (At4 I3 I3) r3e
