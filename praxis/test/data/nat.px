module NatTheorems where

-- By clauses on a value of Nat: a case for 0, and one for S n, the recursive
-- call at n its induction hypothesis.
zero-add : (n : nat) -> 0 + n ≡ n
zero-add 0 = rfl
zero-add (S n) = cong (zero-add n)

-- The same, by the tactic.
zero-add-by : (n : nat) -> 0 + n ≡ n
zero-add-by n = by
  induction n
  { rfl }
  { cong IH }

-- A comparison is its equation in the core, lt 0 (S m) = 1, which unfolding
-- the definitions proves.
zero-lt-succ : (m : nat) -> 0 < S m
zero-lt-succ m = rfl

zero-lt-succ-by-cases : (m : nat) -> 0 < S m
zero-lt-succ-by-cases 0 = rfl
zero-lt-succ-by-cases (S n) = rfl

data PLt (n : nat) (m : nat) where
  ZeroSucc : {m : nat} -> PLt 0 (S m)
  SuccSucc : {n m : nat} -> PLt n m -> PLt (S n) (S m)

-- A value quantified over without a name: the type before an arrow to a
-- proposition.
plt-zero : {n m : nat} -> PLt n m -> 0 < m
plt-zero ZeroSucc = rfl
plt-zero (SuccSucc p) = rfl

data List a = Nil | Cons a (List a)

length : List a -> Nat
length Nil = 0
length (Cons _ xs) = S (length xs)

-- A function matching on a value of Nat, recursive at the predecessor; its
-- results are members of their type by induction on the value.
replicate : Nat -> a -> List a
replicate 0 x = Nil
replicate (S n) x = Cons x (replicate n x)

length-replicate : (n : nat) -> (x : a) -> length (replicate n x) ≡ n
length-replicate 0 x = rfl
length-replicate (S n) x = cong (length-replicate n x)

double : Nat -> Nat
double 0 = 0
double (S n) = S (S (double n))

double-succ : (n : nat) -> double (S n) ≡ S (S (double n))
double-succ n = rfl

-- Matching on two values of Nat at once, recursive at both predecessors:
-- course-of-values recursion on the code of their tuple.
min-nat : Nat -> Nat -> Nat
min-nat 0 m = 0
min-nat (S n) 0 = 0
min-nat (S n) (S m) = S (min-nat n m)

min-succ : (n m : nat) -> min-nat (S n) (S m) ≡ S (min-nat n m)
min-succ n m = rfl

-- The evidence of a comparison, from the comparison: implicit values taken at
-- runtime and matched on together, a proof as an argument, and the recursion
-- at both predecessors. Its results are members of PLt, at the indices its
-- type says, by induction on the code of the pair of its values.
plt-of-lt : {n m : nat} -> (n < m) -> PLt n m
plt-of-lt {0} {S m} h = ZeroSucc
plt-of-lt {S n} {S m} h = SuccSucc (plt-of-lt h)
plt-of-lt {n} {0} h = absurd h

-- The comparison, from its evidence: the induction hypothesis the comparison
-- the goal is once both are unfolded, S n < S m being n < m.
lt-of-plt : {n m : nat} -> PLt n m -> (n < m)
lt-of-plt ZeroSucc = rfl
lt-of-plt (SuccSucc p) = lt-of-plt p

-- No evidence has 0 as its right index: the absurd pattern, (), is the only
-- clause, no constructor able to match there, and each case is refuted.
plt-not-zero : {n : nat} -> PLt n 0 -> ⊥
plt-not-zero ()

absurd-plt : {n : nat} -> PLt n 0 -> a
absurd-plt ()

-- A theorem's clause names its implicit values, in braces, and its
-- hypotheses, after the patterns of its values: h proves S n < S m, which is
-- n < m once unfolded.
lt-of-succ-lt : {n m : nat} -> S n < S m -> n < m
lt-of-succ-lt {n} {m} h = h

-- A hypothesis mentioning the value matched on, named in each clause: the
-- case for 0, which no clause has, refuted by it.
pos-pred : (n : nat) -> 0 < n -> S (n - 1) ≡ n
pos-pred (S k) h = rfl

cons-pos : (xs : List a) -> 0 < length xs -> 0 < S (length xs)
cons-pos Nil h = rfl
cons-pos (Cons x xs) h = rfl

-- The evidence of n < k, from n < m and m < k: recursion on three values of
-- Nat at once, m given in braces, which the result does not determine. Each
-- precondition of the recursive call is a hypothesis once unfolded.
plt-trans : {n m k : nat} -> (n < m) -> (m < k) -> PLt n k
plt-trans {0} {0} {0} h g = absurd h
plt-trans {0} {0} {S k} h g = absurd h
plt-trans {0} {S m} {0} h g = absurd g
plt-trans {0} {S m} {S k} h g = ZeroSucc
plt-trans {S n} {0} {0} h g = absurd h
plt-trans {S n} {0} {S k} h g = absurd h
plt-trans {S n} {S m} {0} h g = absurd g
plt-trans {S n} {S m} {S k} h g = SuccSucc (plt-trans {n} {m} {k} h g)

-- n < k from n < m and m < k: lt-of-plt at the evidence plt-trans builds,
-- its conclusion rewritten by the indices plt-trans's lemma gives its result.
lt-trans : {n m k : nat} -> n < m -> m < k -> n < k
lt-trans {n} {m} {k} nltm mltk = lt-of-plt (plt-trans {n} {m} {k} nltm mltk)

-- The same, by the lemma of the library, applied to the hypotheses.
lt-trans-lib : {n m k : nat} -> n < m -> m < k -> n < k
lt-trans-lib {n} {m} {k} nltm mltk = ltTrans nltm mltk
