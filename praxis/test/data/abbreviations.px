module Abbreviations where

-- An abbreviation is a function defined by one equation over variables, as
-- neg and nn are; comparing indices unfolds it where they differ as they
-- stand, so that nn a and (a :=> Bottom) :=> Bottom are one index to
-- inference.  size, by cases, is no abbreviation: size a stays as it is.
data Formula = Atom Nat | Bottom | Formula :=> Formula

infixr 5 :=>

neg : Formula -> Formula
neg a = a :=> Bottom

nn : Formula -> Formula
nn a = neg (neg a)

size : Formula -> Nat
size (Atom n) = 1
size Bottom = 1
size (a :=> b) = S (size a + size b)

-- Derivations: an axiom retains its formula; modus ponens stores its conclusion.
data Pf (a : Formula) where
  Ax : {a : Formula} -> Pf a
  (:@) : {a b : Formula} -> Pf (a :=> b) -> Pf a -> Pf b

infixl 9 :@

-- The implicit a of dni is determined through nn, by the type expected of
-- dni: against Pf (_ :=> nn a), the second part of its conclusion unfolds
-- nn a.  The use is transported to the type expected by a certified equation.
dni : {a : Formula} -> Pf (a :=> (a :=> Bottom) :=> Bottom)
dni {a} = Ax

intro : Pf a -> Pf (nn a)
intro p = dni :@ p

-- The other way round: the abbreviation in the head's type, the type expected
-- unfolded.
dni-folded : {a : Formula} -> Pf (a :=> nn a)
dni-folded {a} = Ax

intro-unfolded : Pf a -> Pf ((a :=> Bottom) :=> Bottom)
intro-unfolded p = dni-folded :@ p

-- Different abbreviations on the two sides, each unfolded as far as it must
-- be for them to meet.
dni-twice : {a : Formula} -> Pf (a :=> neg (neg a))
dni-twice {a} = Ax

intro-twice : Pf a -> Pf (nn a)
intro-twice p = dni-twice :@ p

-- An implicit the type expected leaves open: a is found from the type of f
-- once that is checked, so the application of mp is put off and checked
-- again after f.
mp : {a b : Formula} -> Pf (nn (a :=> b) :=> nn a :=> nn b)
mp {a} {b} = Ax

lift : Pf (nn (a :=> b)) -> Pf (nn a) -> Pf (nn b)
lift {a} {b} f x = mp :@ f :@ x

-- The same with the types unfolded: nn (a :=> b) is matched against
-- ((a :=> b) :=> Bottom) :=> Bottom.
lift-unfolded : Pf (((a :=> b) :=> Bottom) :=> Bottom) -> Pf (nn a) -> Pf ((b :=> Bottom) :=> Bottom)
lift-unfolded {a} {b} f x = mp :@ f :@ x

-- The implicit a of count is determined through nn by the type of the
-- argument, the type expected of the argument having a hole under nn.
count : {a : Formula} -> Pf (nn a) -> Nat
count {a} p = 0

counted : Pf ((c :=> Bottom) :=> Bottom) -> Nat
counted {c} p = count p

-- Types which agree once both are unfolded: the equation of their indices
-- names a, which the clause binds.
mix : Pf (neg (nn a)) -> Pf (nn (neg a))
mix {a} p = p

-- Abbreviations in the kinds of a signature's variables: v is a Vec two from
-- the field of MkBox and a Vec 2 from Ix2, in either order.
data Vec (n : Nat) where
  Nil : Vec 0
  Cons : {n : Nat} -> Nat -> Vec n -> Vec (S n)

two : Nat
two = 2

inc : Nat -> Nat
inc n = S n

data Box = MkBox (Vec two)

data Ix (b : Box) where
  MkIx : {b : Box} -> Ix b

data Ix2 (v : Vec 2) where
  MkIx2 : {v : Vec 2} -> Ix2 v

both : Ix (MkBox v) -> Ix2 v -> Nat
both x y = 0

both-reversed : Ix2 v -> Ix (MkBox v) -> Nat
both-reversed y x = 0

-- A constructor two data types have, chosen by the type of the index it
-- stands in: Shape's Circle takes a Nat, Color's a Formula.
data Color = Red | Circle Formula

data Shape = Square | Circle Nat

data IxS (s : Shape) where
  MkS : {s : Shape} -> IxS s

data IxC (c : Color) where
  MkC : {c : Color} -> IxC c

shared : IxS (Circle n) -> IxC (Circle f) -> Nat
shared s c = 0

shared-used : IxS (Circle 3) -> IxC (Circle Bottom) -> Nat
shared-used s c = shared s c

-- A pattern on an index an abbreviation names unfolds it: Vec (inc n) is
-- Vec (S n), which Cons matches.
tl : {n : Nat} -> Vec (inc n) -> Vec n
tl {n} (Cons x xs) = xs

-- Abbreviations under the arithmetic of Nat: inc n + inc n is S n + S n once
-- inc is unfolded, both in a type expected and in inferring n.
widen : {n : Nat} -> Vec (inc n + inc n) -> Vec (S n + S n)
widen {n} xs = xs

count-widen : {n : Nat} -> Vec (inc n + inc n) -> Nat
count-widen {n} xs = 0

use-widen : {n : Nat} -> Vec (S n + S n) -> Nat
use-widen {n} xs = count-widen xs
