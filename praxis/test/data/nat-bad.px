module NatBad where

-- A clause on a numeral other than 0.
one-lt : (m : nat) -> 0 < S m
one-lt 1 = rfl
one-lt m = rfl

-- A proof matched on as a value: a proposition has no constructors.
prop-arg : {n m : nat} -> (n < m) -> Nat
prop-arg (S k) = 0

data PLt (n : nat) (m : nat) where
  ZeroSucc : {m : nat} -> PLt 0 (S m)
  SuccSucc : {n m : nat} -> PLt n m -> PLt (S n) (S m)

-- An absurd pattern where a constructor can match: ZeroSucc, at PLt 0 1.
not-absurd : {n : nat} -> PLt n 1 -> Nat
not-absurd ()

-- An absurd pattern with a right side.
absurd-rhs : {n : nat} -> PLt n 0 -> Nat
absurd-rhs () = 0

-- A clause without a right side, and no absurd pattern.
no-rhs : Nat -> Nat
no-rhs n

-- The absurd pattern as a term.
unit-term : Nat
unit-term = ()

-- A theorem's implicit value matched on, with no clause for S n, which is not refuted.
match-implicit : {n : nat} -> 0 < S n
match-implicit {0} = rfl

-- More patterns than the values and the hypotheses of the theorem.
too-many : {n : nat} -> 0 < n -> 0 < S n
too-many h g = rfl

-- An implicit value which is an index of the value matched on: no variable of the statement.
match-index : {n m : nat} -> PLt n m -> 0 < m
match-index {n} {S k} p = rfl
