module Gadt where

-- A data type indexed by a value, in the GADT style: the lists of a length.
data Vec a n where
  nil : Vec a 0
  (:-) : {n: nat} -> a -> Vec a n -> Vec a (S n)

infixr 5 :-

-- nil is impossible at S n: its clause is omitted, and why is certified.
tail : Vec a (S n) -> Vec a n
tail (_ :- tl) = tl

head : Vec a (S n) -> a
head (x :- _) = x

-- The index of the argument, found through tail's own twice.
tail-two : Vec a (S (S n)) -> Vec a n
tail-two v = tail (tail v)

-- A kind given with the parameter; fzero stores its implicit argument,
-- which no field of it determines.
data Fin (n : nat) where
  fzero : {m : nat} -> Fin (S m)
  fsucc : {m : nat} -> Fin m -> Fin (S m)

zero-of : Fin 3
zero-of = fzero

-- A kind in a kind signature.
type Vec2 : type -> nat -> type
data Vec2 a n where
  nil2 : Vec2 a 0
  cons2 : {n : nat} -> a -> Vec2 a n -> Vec2 a (S n)

first : Vec2 a (S n) -> a
first (cons2 x _) = x

-- The length of a list, which its index is: the value n, bare as the
-- index of v, stands for the index of v.
length : Vec a n -> Nat
length nil = 0
length (_ :- xs) = S (length xs)

length-index : (v : Vec a n) -> length v ≡ n
length-index nil = rfl
length-index (x :- xs) = cong (length-index xs)

-- nil is impossible at S n: its case is refuted, as for a function.
head-tail : (v : Vec a (S n)) -> v ≡ head v :- tail v
head-tail (x :- xs) = rfl

-- The index head-tail needs of its argument, found.
head-tail-two : (w : Vec a (S (S m))) -> w ≡ head w :- tail w
head-tail-two w = head-tail w

-- Implicit parameters of the head, whose kinds the indices' kinds give: two
-- lists equal element by element. The type of an index may mention the type
-- parameters and the indices before it.
data SameVec {a} {n} {m} (l : Vec a n) (r : Vec a m) where
  BothNil : SameVec nil nil
  BothCons : {x : a} -> {xs : Vec a n} -> {ys : Vec a m} -> SameVec xs ys -> SameVec (x :- xs) (x :- ys)

-- Codes are compared: xs and ys are lists of lengths not known to be one.
same-eq : {xs : Vec a n} -> {ys : Vec a m} -> (p : SameVec xs ys) -> xs ≡ ys
same-eq BothNil = rfl
same-eq (BothCons q) = cong (same-eq q)

-- An implicit value its clauses bind is taken at runtime: where the function
-- is applied, it is found from the type expected, and passed.
replicate-vec : {n : nat} -> a -> Vec a n
replicate-vec {0} x = nil
replicate-vec {S k} x = x :- replicate-vec x

len : {n : nat} -> Vec a n -> Nat
len {n} v = n

len-replicate : {n : nat} -> (x : a) -> len (replicate-vec x : Vec a n) ≡ n
len-replicate x = rfl

-- A proof as an argument: its proposition a precondition, the proof named in
-- the clauses and given at each call, where it is checked; absurd takes a
-- proof of what cannot be, and is a value of any type.
head-safe : {n : nat} -> (0 < n) -> Vec a n -> a
head-safe h (x :- _) = x
head-safe h nil = absurd h

head-of-two : Vec a 2 -> a
head-of-two v = head-safe rfl v

-- Implicit arguments in braces: a function's value, which nothing else here
-- determines; a constructor's; and in a type, a data type's type parameter,
-- which the indices written leave open.
three : a -> Nat
three x = len (replicate-vec {3} x)

three-is : (x : a) -> three x ≡ 3
three-is x = rfl

zero-of-three : Fin 3
zero-of-three = fzero {2}

both-nil : SameVec {Nat} nil nil
both-nil = BothNil

-- A named field, (m : nat) ->, is a value the constructor takes, in scope for
-- the indices of its result, as an implicit argument is: Zero m is at
-- PLt2 0 (S m). Matching Zero k learns the index from k, and k from the index.
data PLt2 (n : nat) (m : nat) where
  Zero : (m : nat) -> PLt2 0 (S m)
  Succ : {n m : nat} -> PLt2 n m -> PLt2 (S n) (S m)

plt2-of-lt : {n m : nat} -> (n < m) -> PLt2 n m
plt2-of-lt {0} {S m} h = Zero m
plt2-of-lt {S n} {S m} h = Succ (plt2-of-lt h)
plt2-of-lt {n} {0} h = absurd h

lt-of-plt2 : {n m : nat} -> PLt2 n m -> (n < m)
lt-of-plt2 (Zero k) = rfl
lt-of-plt2 (Succ p) = lt-of-plt2 p

-- The field named in a pattern, the right index the successor of it.
plt2-zero : {n m : nat} -> PLt2 n m -> 0 < m
plt2-zero (Zero k) = rfl
plt2-zero (Succ p) = rfl

-- A constructor taking a proof, a precondition its code does not store, which
-- the membership of its code checks as it checks an equation of indices: the
-- existential form of the strict ordering.
data ELt (n : nat) (m : nat) where
  Exists : (k : nat) -> n + S k = m -> ELt n m

witness : ELt n m -> Nat
witness (Exists k _) = k

-- The proof named in the pattern is a hypothesis of the case: the goal, once
-- the index functions and witness are unfolded.
elt-witness : {n m : nat} -> (p : ELt n m) -> n + S (witness p) ≡ m
elt-witness (Exists k h) = h

-- Building with a proof: the precondition is an obligation, proved by the
-- proof term given, under the precondition the pattern names; n and m, which
-- the code stores, are taken at runtime.
elt-succ : {n m : nat} -> ELt n m -> ELt n (S m)
elt-succ {n} {m} (Exists k h) = Exists (S k) (cong h)

elt-two : ELt 0 2
elt-two = Exists 1 rfl
