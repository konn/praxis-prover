cabal-version: 3.4
name: praxis
version: 0.1.0.0
description: Please see the README on GitHub at <https://github.com/konn/praxis#readme>
homepage: https://github.com/konn/praxis#readme
bug-reports: https://github.com/konn/praxis/issues
author: Hiromi ISHII
maintainer: konn.jinro_at_gmail.com
copyright: (c) Hiromi ISHII 2026- present
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
tested-with:
  ghc ==9.12.4

extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files:
  src-pra/*.pra
  src-pra/*.prf
  test/data/**/*.px
  test/data/**/*.toml
  test/data/*.px

data-files:
  data/libraries/base/README.md
  data/libraries/base/package.toml
  data/libraries/base/src/**/*.px

source-repository head
  type: git
  location: https://github.com/konn/praxis
  subdir: praxis

common defaults
  other-modules: Paths_praxis
  autogen-modules: Paths_praxis
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints
    -Wunused-packages

  build-depends: base >=4.7 && <5
  default-language: GHC2024
  default-extensions:
    BlockArguments
    DerivingStrategies
    MultiWayIf

library
  import: defaults
  hs-source-dirs: src
  -- cabal-gild: discover src --exclude=src/**/Internal.hs --exclude=src/**/Internal/**/*.hs
  exposed-modules:
    Language.Praxis.Package.Build
    Language.Praxis.Package.Manifest
    Language.Praxis.Package.Version
    Language.Praxis.Surface.Builtin
    Language.Praxis.Surface.Check
    Language.Praxis.Surface.Compile
    Language.Praxis.Surface.Core
    Language.Praxis.Surface.Core.Pretty
    Language.Praxis.Surface.Core.Types
    Language.Praxis.Surface.CoreText
    Language.Praxis.Surface.Desugar
    Language.Praxis.Surface.Elab
    Language.Praxis.Surface.Encode
    Language.Praxis.Surface.Engine
    Language.Praxis.Surface.Env
    Language.Praxis.Surface.Evidence
    Language.Praxis.Surface.Fixity
    Language.Praxis.Surface.Index
    Language.Praxis.Surface.Lexer
    Language.Praxis.Surface.Mangle
    Language.Praxis.Surface.Match
    Language.Praxis.Surface.Parser
    Language.Praxis.Surface.Prelude
    Language.Praxis.Surface.Pretty
    Language.Praxis.Surface.Rename
    Language.Praxis.Surface.Resolve
    Language.Praxis.Surface.Shape
    Language.Praxis.Surface.SourceView
    Language.Praxis.Surface.Syntax
    Language.Praxis.Surface.Syntax.Raw
    Language.Praxis.Surface.Term
    Language.Praxis.Surface.Types

  -- cabal-gild: discover src --include=src/**/Internal.hs --include=src/**/Internal/**/*.hs
  other-modules:
  build-depends:
    bound,
    containers,
    directory,
    filepath,
    megaparsec,
    mtl,
    praxis-core,
    template-haskell,
    text,
    text-builder-linear,
    toml-reader,

executable praxis
  import: defaults
  hs-source-dirs: app
  main-is: Main.hs
  -- cabal-gild: discover app --exclude=app/Main.hs
  other-modules:
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    directory,
    filepath,
    optparse-applicative,
    praxis,
    text,

test-suite praxis-test
  import: defaults
  type: exitcode-stdio-1.0
  main-is: Test.hs
  hs-source-dirs: test
  -- cabal-gild: discover test --exclude=test/Test.hs
  other-modules:
    Language.Praxis.Package.PackageTest
    Language.Praxis.Surface.AdequacyTest
    Language.Praxis.Surface.BuiltinCheckTest
    Language.Praxis.Surface.BuiltinTest
    Language.Praxis.Surface.CheckTest
    Language.Praxis.Surface.ClassAdmissionTest
    Language.Praxis.Surface.ComputationIndexTest
    Language.Praxis.Surface.CoreTest
    Language.Praxis.Surface.DependentClassTest
    Language.Praxis.Surface.EvidenceTest
    Language.Praxis.Surface.FiniteElaborationTest
    Language.Praxis.Surface.FiniteFixtures
    Language.Praxis.Surface.FiniteQuantifierTest
    Language.Praxis.Surface.FiniteTacticTest
    Language.Praxis.Surface.IndexedInstanceTest
    Language.Praxis.Surface.InstanceContextTest
    Language.Praxis.Surface.LogicalPreconditionTest
    Language.Praxis.Surface.MethodContractTest
    Language.Praxis.Surface.ParserTest
    Language.Praxis.Surface.ProjectionIndexTest
    Language.Praxis.Surface.QuantifierCaptureTest
    Language.Praxis.Surface.ResolveTest
    Language.Praxis.Surface.TermTest

  ghc-options:
    -threaded
    -O2
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    QuickCheck,
    bound,
    containers,
    megaparsec,
    praxis,
    praxis-core,
    tasty,
    tasty-hunit,
    tasty-quickcheck,
    text,
    text-builder-linear,
    toml-reader,
