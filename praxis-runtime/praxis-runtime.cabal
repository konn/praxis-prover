cabal-version: 3.4
name: praxis-runtime
version: 0.1.0.0
synopsis: Shared constructor runtime for extracted Praxis programs
description: Portable shared-constructor evaluator and checked JSON boundary for extracted Praxis Surface programs.
category: Language
maintainer: konn.jinro_at_gmail.com
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules:
    Language.Praxis.Runtime
    Language.Praxis.Runtime.Program

  default-language: GHC2024
  ghc-options: -Wall
  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.21 && <5,
    bytestring,
    containers,
    mtl,
    scientific,
    text,
    vector,
