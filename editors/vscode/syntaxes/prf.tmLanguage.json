{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Praxis definitions",
  "scopeName": "source.prf",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.other.declaration.prf",
      "match": "(?<![\\p{L}\\p{N}_'])(environment|extends)(?![\\p{L}\\p{N}_'])"
    },
    {
      "name": "keyword.control.conditional.prf",
      "match": "(?<![\\p{L}\\p{N}_'])(if|then|else)(?![\\p{L}\\p{N}_'])"
    },
    {
      "name": "constant.language.successor.prf",
      "match": "(?<![\\p{L}\\p{N}_'])(S|Succ)(?![\\p{L}\\p{N}_'])"
    },
    {
      "comment": "The function an equation defines: the name heading a line with an equation.",
      "match": "^\\s*([\\p{L}][\\p{L}\\p{N}_']*)(?=(?:\\s|\\{).*(?<![<>=!:])=(?![=>]))",
      "captures": {
        "1": {
          "name": "entity.name.function.prf"
        }
      }
    },
    {
      "comment": "A schema applied to function parameters, named: a brace group of names alone.",
      "match": "\\{\\s*([\\p{L}][\\p{L}\\p{N}_']*(?:\\s*,\\s*[\\p{L}][\\p{L}\\p{N}_']*)*)\\s*\\}",
      "captures": {
        "1": {
          "name": "variable.parameter.prf"
        }
      }
    },
    {
      "comment": "The variadic group of a template, passed through to its parameter.",
      "name": "variable.other.variadic.prf",
      "match": "\\$\\[[^\\]]*\\]"
    },
    {
      "name": "constant.numeric.prf",
      "match": "(?<![\\p{L}\\p{N}_'])[0-9]+(?![\\p{L}\\p{N}_'])"
    },
    {
      "name": "keyword.operator.quantifier.prf",
      "match": "μ|λ|∀|∃|(?<![\\p{L}\\p{N}_'])(forall|exists)(?![\\p{L}\\p{N}_'])"
    },
    {
      "include": "#terms"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.prf",
          "begin": "\\{-",
          "end": "-\\}",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        },
        {
          "name": "comment.line.double-dash.prf",
          "match": "--.*$"
        }
      ]
    },
    "terms": {
      "patterns": [
        {
          "name": "keyword.operator.term.prf",
          "match": "<=|==|<|=|\\+|-|\\*|\\^|\\."
        },
        {
          "name": "constant.language.wildcard.prf",
          "match": "(?<![\\p{L}\\p{N}_'])_(?![\\p{L}\\p{N}_'])"
        }
      ]
    }
  }
}
