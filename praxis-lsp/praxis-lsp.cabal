cabal-version: 3.4
name: praxis-lsp
version: 0.1.0.0
synopsis: A language server for the pra and prf files of praxis
description: Please see the README on GitHub at <https://github.com/konn/praxis#readme>
homepage: https://github.com/konn/praxis#readme
bug-reports: https://github.com/konn/praxis/issues
author: Hiromi ISHII
maintainer: konn.jinro_at_gmail.com
copyright: (c) Hiromi ISHII 2026- present
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
tested-with:
  ghc ==9.12.4

extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type: git
  location: https://github.com/konn/praxis
  subdir: praxis-lsp

common defaults
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints
    -Wunused-packages

  build-depends: base >=4.7 && <5
  default-language: GHC2024
  default-extensions:
    BlockArguments
    OverloadedRecordDot
    OverloadedStrings

library
  import: defaults
  hs-source-dirs: src
  -- cabal-gild: discover src
  exposed-modules: Language.Praxis.LSP
  build-depends:
    containers,
    filepath,
    lsp,
    lsp-types,
    praxis-core,
    text,

executable praxis-lsp
  import: defaults
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends: praxis-lsp

test-suite praxis-lsp-test
  import: defaults
  type: exitcode-stdio-1.0
  main-is: Test.hs
  hs-source-dirs: test
  build-depends:
    lsp-types,
    praxis-lsp,
    tasty,
    tasty-hunit,
    text,
